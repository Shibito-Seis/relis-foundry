<section
  class="relis-sheet relis-sheet--item relis-item-sheet"
  data-document-id="{{item.id}}"
>
  <header class="relis-item-header">
    <button
      class="relis-item-icon"
      type="button"
      data-action="edit-image"
      title="Choisir l’illustration"
      aria-label="Choisir l’illustration de {{item.name}}"
    >
      <img src="{{item.img}}" alt="Illustration de {{item.name}}" />
      <span class="relis-item-icon-action" aria-hidden="true">
        <i class="fa-solid fa-image"></i>
      </span>
    </button>
    <div class="relis-item-heading">
      <p class="relis-kicker">RE:LIS — {{itemTypeLabel}}</p>
      <input
        class="relis-name"
        type="text"
        value="{{item.name}}"
        data-document-field="name"
      />
      <div class="relis-trait-bar" aria-label="Traits de l’Item">
        <span class="relis-trait-bar-label">Traits</span>
        {{#if canEditTraits}}
          <multi-select
            class="relis-trait-selector"
            name="system.traits"
            data-trait-selector
          >
            {{#each traitOptions}}
              {{#if this.selected}}
                <option
                  value="{{this.value}}"
                  selected
                  data-selected-trait
                >{{this.label}}</option>
              {{else}}
                <option value="{{this.value}}">{{this.label}}</option>
              {{/if}}
            {{/each}}
          </multi-select>
        {{else}}
          <div class="relis-trait-readonly">
            {{#each selectedTraits}}
              <span class="relis-trait-chip">{{this.label}}</span>
            {{else}}
              <span class="relis-trait-empty">Aucun trait</span>
            {{/each}}
          </div>
        {{/if}}
      </div>
    </div>
    <div class="relis-item-badges" aria-label="État de l’Item">
      {{#each badges}}
        <span class="relis-state-chip {{this.className}}">{{this.label}}</span>
      {{/each}}
    </div>
  </header>

  {{#if diagnostics.length}}
    <aside class="relis-item-diagnostics" aria-label="Diagnostics">
      {{#each diagnostics}}
        <p class="relis-item-diagnostic relis-item-diagnostic--{{this.level}}">
          <i class="fa-solid {{this.icon}}"></i>
          {{this.message}}
        </p>
      {{/each}}
    </aside>
  {{/if}}

  <div class="relis-item-layout">
    <section class="relis-card relis-item-description-card">
      <p class="relis-kicker">Contenu commun</p>
      <div class="relis-section-heading relis-description-heading">
        <h2>Description</h2>
        {{#if canManageDescriptionPermission}}
          <label class="relis-description-permission">
            <input
              type="checkbox"
              {{checked system.permissions.playerEditableDescription}}
              data-value-type="boolean"
              data-document-field="system.permissions.playerEditableDescription"
            />
            Autoriser le propriétaire PJ à modifier
          </label>
        {{/if}}
      </div>
      <div class="relis-item-description">
        <div
          class="relis-description-editor-host"
          data-description-editor-host
        ></div>
      </div>
      <div class="relis-item-ref-summary">
        <span>{{requirementCount}} prérequis référencé(s)</span>
        <span>{{effectRefCount}} effet(s) référencé(s)</span>
      </div>
    </section>

    {{#if hasCatalog}}
      <section class="relis-card">
        <p class="relis-kicker">Valeurs stables</p>
        <h2>Catalogue</h2>
        <div class="relis-grid relis-grid--form relis-item-form">
          {{#if applicability.level}}
            <label>
              Niveau
              <input
                type="number"
                min="1"
                max="30"
                value="{{system.level}}"
                data-value-type="nullable-number"
                data-document-field="system.level"
              />
            </label>
          {{/if}}
          {{#if applicability.quality}}
            <label>
              Qualité
              <select
                data-document-field="system.quality"
                data-value-type="nullable-number"
              >
                {{selectOptions
                  qualityOptions
                  selected=system.quality
                  valueAttr="value"
                  labelAttr="label"
                }}
              </select>
            </label>
          {{/if}}
          {{#if applicability.rarity}}
            <label>
              Rareté
              <select
                data-document-field="system.rarity"
                data-value-type="nullable-number"
              >
                {{selectOptions
                  rarityOptions
                  selected=system.rarity
                  valueAttr="value"
                  labelAttr="label"
                }}
              </select>
            </label>
          {{/if}}
          {{#if applicability.legality}}
            <label>
              Légalité
              <select data-document-field="system.legality">
                {{selectOptions
                  legalityOptions
                  selected=system.legality
                  valueAttr="value"
                  labelAttr="label"
                }}
              </select>
            </label>
          {{/if}}
          {{#if applicability.manufacturer}}
            <label>
              Fabricant — identifiant durable
              <input
                type="text"
                value="{{system.manufacturerRef.relisId}}"
                data-document-field="system.manufacturerRef.relisId"
              />
            </label>
            <label>
              Fabricant — libellé mémorisé
              <input
                type="text"
                value="{{system.manufacturerRef.labelSnapshot}}"
                data-document-field="system.manufacturerRef.labelSnapshot"
              />
            </label>
          {{/if}}
        </div>
        {{#if applicability.referencePrice}}
          <h2>Prix de référence</h2>
          <p class="relis-scope-note">
            Valeur de catalogue uniquement. Les devis datés et locaux
            appartiennent aux marchés de 10-J.
          </p>
          <div class="relis-grid relis-grid--form relis-item-form">
            <label>
              Montant
              <input
                type="number"
                min="0"
                step="any"
                value="{{system.referencePrice.amount}}"
                data-value-type="nullable-number"
                data-document-field="system.referencePrice.amount"
              />
            </label>
            <label>
              Pour une quantité de
              <input
                type="number"
                min="0.000001"
                step="any"
                value="{{system.referencePrice.quantityBasis}}"
                data-value-type="number"
                data-document-field="system.referencePrice.quantityBasis"
              />
            </label>
            <label>
              Unité de prix
              <input
                type="text"
                value="{{system.referencePrice.unit}}"
                data-document-field="system.referencePrice.unit"
              />
            </label>
            <label>
              Monnaie — identifiant durable
              <input
                type="text"
                value="{{system.referencePrice.currencyRef.relisId}}"
                data-document-field="system.referencePrice.currencyRef.relisId"
              />
            </label>
          </div>
        {{/if}}
      </section>
    {{/if}}

    {{#if hasPhysical}}
      <section
        class="relis-card relis-equipment-profile"
        data-equipment-profile
      >
        <p class="relis-kicker">Propriétés de l’objet</p>
        <h2>Usage et compatibilités</h2>
        <div class="relis-grid relis-grid--form relis-item-form">
          <label>Usage<select data-profile-field="family">
              {{selectOptions
                equipmentFamilies
                selected=system.physical.equipmentProfile.family
              }}
            </select></label>
          <label>Temps et aide nécessaires — selon la source<input
              type="text"
              data-profile-field="duration"
              value="{{system.physical.equipmentProfile.duration}}"
            /></label>
          <label><input
              type="checkbox"
              data-profile-field="installable"
              {{checked system.physical.equipmentProfile.installable}}
            />
            Installable sur un autre objet</label>
          <label><input
              type="checkbox"
              data-profile-field="ordinaryLiquid"
              {{checked system.physical.equipmentProfile.ordinaryLiquid}}
            />
            Liquide ordinaire : 1 L ≈ 1 kg si masse absente</label>
        </div>
        {{#each equipmentProfileGroups}}
          <fieldset><legend>{{title}}</legend>
            <p>{{#if count}}{{count}}
                choix enregistré(s).{{else}}{{emptyLabel}}{{/if}}</p>
            <div class="relis-profile-choices">
              {{#each choices}}<label><input
                    type="checkbox"
                    data-profile-list="{{groupKey}}"
                    value="{{value}}"
                    {{checked checked}}
                  />
                  {{label}}</label>{{/each}}
            </div>
          </fieldset>
        {{/each}}
        {{#if equipmentSlotErrors}}
          <aside class="relis-inventory-diagnostics">{{#each
              equipmentSlotErrors
            }}<p>{{this}}</p>{{/each}}
            Les anciennes valeurs sont conservées jusqu’à l’enregistrement de
            vos choix corrigés sur cet objet.
          </aside>
        {{/if}}
        <p>Ces choix concernent uniquement cet objet. {{equipmentSlotHint}}</p>
        <p>Les emplacements corporels cochés sont occupés ensemble quand l’objet
          est équipé. Ils ne décrivent pas les zones protégées. Les listes de
          tailles et natures vides n’imposent aucune restriction.</p>
        {{#if legacyEquipmentSlot}}<aside
            class="relis-inventory-diagnostics"
          >Ancien emplacement conservé :
            {{legacyEquipmentSlot}}. Reconfigurez les choix ci-dessus et les
            besoins techniques ci-dessous, puis enregistrez. Aucune conversion
            automatique.
            <label><input type="checkbox" data-legacy-slots-confirm />
              Je remplace l’ancien emplacement par les choix corporels et
              techniques de cette fiche, y compris si je les laisse vides.</label>
          </aside>{{/if}}
        <details class="relis-technical-slots"><summary>Emplacements techniques
            — capacités et besoins</summary>
          <p>Fourni : capacité de cet objet comme hôte. Requis : quantité
            occupée sur l’hôte lorsque cet objet est installé. Zéro signifie
            aucun. Vérifier aussi les compatibilités déclarées par la source de
            l’objet.</p>
          <div class="relis-slot-grid"><b>Type</b><b>Fourni par cet objet</b><b
            >Requis sur l’hôte</b>
            {{#each technicalSlotRows}}
              <span>{{label}}</span>
              <label><span class="relis-slot-input-label">{{label}}
                  fourni</span><input
                  type="number"
                  min="0"
                  step="1"
                  value="{{provided}}"
                  data-profile-technical="providedSlots"
                  data-slot-key="{{key}}"
                /></label>
              <label><span class="relis-slot-input-label">{{label}}
                  requis</span><input
                  type="number"
                  min="0"
                  step="1"
                  value="{{required}}"
                  data-profile-technical="requiredSlots"
                  data-slot-key="{{key}}"
                /></label>
            {{/each}}</div>
        </details>
        {{#if editable}}<button
            type="button"
            data-save-equipment-profile
          >Enregistrer les propriétés d’équipement</button><p
            data-profile-status
            role="status"
          >Propriétés enregistrées affichées.</p>{{/if}}
      </section>

      <section class="relis-card">
        <p class="relis-kicker">Exemplaire matériel</p>
        <h2>État physique</h2>
        <div class="relis-grid relis-grid--form relis-item-form">
          <label>
            Quantité
            <input
              type="number"
              min="0"
              step="any"
              value="{{system.physical.quantity}}"
              data-value-type="number"
              data-document-field="system.physical.quantity"
            />
          </label>
          <label>
            Unité
            <select data-document-field="system.physical.unit">
              {{selectOptions
                quantityUnitOptions
                selected=system.physical.unit
                valueAttr="value"
                labelAttr="label"
              }}
            </select>
          </label>
          <label>
            Masse unitaire
            <input
              type="number"
              min="0"
              step="any"
              value="{{system.physical.massEach}}"
              data-value-type="nullable-number"
              data-document-field="system.physical.massEach"
            />
          </label>
          <label>
            Volume unitaire
            <input
              type="number"
              min="0"
              step="any"
              value="{{system.physical.volumeEach}}"
              data-value-type="nullable-number"
              data-document-field="system.physical.volumeEach"
            />
          </label>
          <label>
            Encombrement unitaire
            <input
              type="number"
              min="0"
              step="any"
              value="{{system.physical.bulkEach}}"
              data-value-type="nullable-number"
              data-document-field="system.physical.bulkEach"
            />
          </label>
          <label>
            Localisation
            <input
              type="text"
              value="{{system.physical.locationKey}}"
              data-document-field="system.physical.locationKey"
            />
          </label>
          <label>
            Lot traçable
            <input
              type="text"
              value="{{system.provenance.lotId}}"
              data-document-field="system.provenance.lotId"
            />
          </label>
          <label>
            Relation de propriété
            <select data-document-field="system.physical.ownershipState">
              {{selectOptions
                ownershipOptions
                selected=system.physical.ownershipState
                valueAttr="value"
                labelAttr="label"
              }}
            </select>
          </label>
          <label>
            Accessibilité
            <select data-document-field="system.physical.accessibility">
              {{selectOptions
                accessibilityOptions
                selected=system.physical.accessibility
                valueAttr="value"
                labelAttr="label"
              }}
            </select>
          </label>
          <label>
            Expiration — affichage diégétique
            <input
              type="text"
              value="{{system.physical.expiresAt.displayOverride}}"
              data-document-field="system.physical.expiresAt.displayOverride"
            />
          </label>
          <label>
            Port
            {{#if isOwnedPhysical}}<span>{{equipmentLabel}}
                — utiliser le bouton d’état dans l’inventaire de l’Actor.</span>{{else}}
              <select data-document-field="system.physical.equipState">
                {{selectOptions
                  equipStateOptions
                  selected=selectedEquipState
                  valueAttr="value"
                  labelAttr="label"
                }}
              </select>
            {{/if}}
          </label>
          <label>
            État
            <select data-document-field="system.physical.condition">
              {{selectOptions
                conditionOptions
                selected=system.physical.condition
                valueAttr="value"
                labelAttr="label"
              }}
            </select>
          </label>
          <label>
            Usure
            <input
              type="number"
              min="0"
              max="6"
              value="{{system.physical.wear}}"
              data-value-type="number"
              data-document-field="system.physical.wear"
            />
          </label>
          <label class="relis-checkbox-field">
            <input
              type="checkbox"
              {{checked system.physical.identified}}
              data-value-type="boolean"
              data-document-field="system.physical.identified"
            />
            Identifié
          </label>
          <label>
            Charges actuelles
            <input
              type="number"
              min="0"
              value="{{system.physical.charges.current}}"
              data-value-type="nullable-number"
              data-document-field="system.physical.charges.current"
            />
          </label>
          <label>
            Charges maximum
            <input
              type="number"
              min="0"
              value="{{system.physical.charges.maximum}}"
              data-value-type="nullable-number"
              data-document-field="system.physical.charges.maximum"
            />
          </label>
        </div>
        <dl class="relis-item-totals">
          <div><dt>Masse totale</dt><dd>{{physicalTotals.mass}}</dd></div>
          <div><dt>Volume total</dt><dd>{{physicalTotals.volume}}</dd></div>
          <div><dt>Encombrement total</dt><dd>{{physicalTotals.bulk}}</dd></div>
        </dl>
        <p class="relis-scope-note">
          Piles, lots, conteneurs et transferts sont opératoires depuis
          l’inventaire de l’Actor. Porter, tenir, équiper et installer arrivent
          en 10-E3-P.
        </p>
      </section>
    {{/if}}

    {{#if isContainer}}
      <section class="relis-card">
        <p class="relis-kicker">Contraintes cumulatives</p>
        <h2>Conteneur</h2>
        <div class="relis-grid relis-grid--form relis-item-form">
          <label>
            Capacité de masse (kg)
            <input
              type="number"
              min="0"
              step="any"
              value="{{system.capacity.mass}}"
              data-value-type="nullable-number"
              data-document-field="system.capacity.mass"
            />
          </label>
          <label>
            Capacité de volume (L)
            <input
              type="number"
              min="0"
              step="any"
              value="{{system.capacity.volume}}"
              data-value-type="nullable-number"
              data-document-field="system.capacity.volume"
            />
          </label>
          <label>
            Capacité d’encombrement
            <input
              type="number"
              min="0"
              step="any"
              value="{{system.capacity.bulk}}"
              data-value-type="nullable-number"
              data-document-field="system.capacity.bulk"
            />
          </label>
          <label>
            Capacité en unités
            <input
              type="number"
              min="0"
              step="any"
              value="{{system.capacity.units}}"
              data-value-type="nullable-number"
              data-document-field="system.capacity.units"
            />
          </label>
          <label>
            Règle d’accès
            <select data-document-field="system.accessRule">
              {{selectOptions
                containerAccessOptions
                selected=system.accessRule
                valueAttr="value"
                labelAttr="label"
              }}
            </select>
          </label>
        </div>
        {{#if containerUsage}}
          <dl class="relis-item-totals">
            <div><dt>Masse contenue</dt><dd>{{containerUsage.mass}}</dd></div>
            <div><dt>Volume contenu</dt><dd>{{containerUsage.volume}}</dd></div>
            <div><dt>Encombrement contenu</dt><dd
              >{{containerUsage.bulk}}</dd></div>
            <div><dt>Unités contenues</dt><dd
              >{{containerUsage.units}}</dd></div>
          </dl>
        {{/if}}
      </section>
    {{/if}}

    {{#if isAction}}
      <section class="relis-card">
        <p class="relis-kicker">Compatibilité 10-C</p>
        <h2>Test de l’Action</h2>
        <div class="relis-grid relis-grid--form relis-item-form">
          <label>
            Attribut
            <select data-document-field="system.test.attributeKey">
              {{selectOptions
                attributes
                selected=system.test.attributeKey
                valueAttr="key"
                labelAttr="label"
              }}
            </select>
          </label>
          <label>
            Compétence
            <select data-document-field="system.test.skillKey">
              {{selectOptions
                skills
                selected=system.test.skillKey
                valueAttr="key"
                labelAttr="label"
              }}
            </select>
          </label>
          <label>
            Difficulté
            <input
              type="number"
              min="0"
              value="{{system.test.difficulty}}"
              data-value-type="number"
              data-document-field="system.test.difficulty"
            />
          </label>
          <label>
            Ressource technique
            <input
              type="text"
              value="{{system.test.resourceKey}}"
              data-document-field="system.test.resourceKey"
            />
          </label>
          <label>
            Coût
            <input
              type="number"
              min="0"
              value="{{system.test.cost}}"
              data-value-type="number"
              data-document-field="system.test.cost"
            />
          </label>
        </div>
        <h2>Effet temporaire</h2>
        <div class="relis-grid relis-grid--form relis-item-form">
          <label>
            Clé de condition
            <input
              type="text"
              value="{{system.effect.conditionKey}}"
              data-document-field="system.effect.conditionKey"
            />
          </label>
          <label>
            Intensité
            <input
              type="number"
              min="0"
              value="{{system.effect.intensity}}"
              data-value-type="number"
              data-document-field="system.effect.intensity"
            />
          </label>
          <label>
            Durée en rounds
            <input
              type="number"
              min="0"
              value="{{system.effect.durationRounds}}"
              data-value-type="number"
              data-document-field="system.effect.durationRounds"
            />
          </label>
        </div>
        <button type="button" data-action="test-item">
          <i class="fa-solid fa-dice-d20"></i>
          Tester l’Action
        </button>
      </section>
    {{/if}}

    <section class="relis-card relis-item-provenance">
      <p class="relis-kicker">Traçabilité</p>
      <h2>Provenance et versions</h2>
      <dl class="relis-fact-list">
        <div><span>Rôle</span><strong>{{itemRole}}</strong></div>
        <div><span>Identifiant RE:LIS</span><code
          >{{system.meta.relisId}}</code></div>
        <div><span>Schéma</span><strong
          >{{system.meta.schemaVersion}}</strong></div>
        <div><span>Règles</span><strong
          >{{system.meta.rulesVersion}}</strong></div>
        <div><span>Contenu</span><strong
          >{{system.meta.contentVersion}}</strong></div>
        <div><span>Révision locale</span><strong
          >{{system.provenance.localRevision}}</strong></div>
        <div><span>Acquisition</span><strong
          >{{system.provenance.acquisitionKind}}</strong></div>
        <div><span>Lot</span><strong>{{system.provenance.lotId}}</strong></div>
      </dl>
      {{#if hasSourceRef}}
        <details>
          <summary>Référence de source</summary>
          <dl class="relis-fact-list">
            <div><span>Identifiant</span><code
              >{{system.meta.sourceRef.relisId}}</code></div>
            <div><span>UUID mémorisé</span><code
              >{{system.meta.sourceRef.uuid}}</code></div>
            <div><span>Version copiée</span><strong
              >{{system.meta.sourceVersion}}</strong></div>
            <div><span>Libellé mémorisé</span><strong
              >{{system.meta.sourceRef.labelSnapshot}}</strong></div>
          </dl>
        </details>
      {{/if}}
      {{#if manualOverrides.length}}
        <details>
          <summary>{{manualOverrides.length}}
            champ(s) modifié(s) localement</summary>
          <ul>
            {{#each manualOverrides}}<li><code>{{this}}</code></li>{{/each}}
          </ul>
        </details>
      {{/if}}
    </section>
  </div>

  <footer class="relis-sheet-footer">
    Étape 10-E1-P · éditeur riche interactif · paquet 0.3.6
  </footer>
</section>