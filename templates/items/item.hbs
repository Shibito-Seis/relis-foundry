      {{#if isContainer}}
        <section class="relis-card relis-material-profile">
          <p class="relis-kicker">Conteneur spécialisé</p><h2>Chargeur
            détachable</h2>
          <div class="relis-grid relis-grid--form relis-item-form">
            <label>Nature<select
                data-document-field="system.containerKind"
              >{{selectOptions
                  containerKindOptions
                  selected=system.containerKind
                }}</select></label>
            <label>Chambrage exact<select
                data-document-field="system.magazineProfile.chamberId"
              >{{selectOptions
                  chamberingOptions
                  selected=system.magazineProfile.chamberId
                }}</select></label>
            <label>Classe de pression / énergie<select
                data-document-field="system.magazineProfile.pressureClass"
              >{{selectOptions
                  pressureClassOptions
                  selected=system.magazineProfile.pressureClass
                }}</select></label>
            <label>Interface du chargeur<select
                data-document-field="system.magazineProfile.interfaceId"
              >{{selectOptions
                  feedInterfaceOptions
                  selected=system.magazineProfile.interfaceId
                }}</select></label>
            <label>Capacité<input
                type="number"
                min="1"
                step="1"
                value="{{system.magazineProfile.capacity}}"
                data-value-type="nullable-number"
                data-document-field="system.magazineProfile.capacity"
              /></label>
          </div>
          <p>Les cartouches restent de vrais Items frères contenus. Leur ordre
            de chargement est géré depuis l’inventaire de l’Actor.</p>
        </section>
      {{/if}}

      <section class="relis-card relis-material-profile">
        <p class="relis-kicker">Durabilité matérielle</p><h2>Structure et
          entretien</h2>
        <p class="relis-scope-note">Un champ vide reste inconnu. Il ne vaut ni
          zéro ni immunité.</p>
        <div class="relis-grid relis-grid--form relis-item-form">
          <label>Solidité propre<input
              type="number"
              min="0"
              step="any"
              value="{{system.physical.durability.solidity}}"
              data-value-type="nullable-number"
              data-document-field="system.physical.durability.solidity"
            /></label>
          <label>PV structurels actuels<input
              type="number"
              min="0"
              step="any"
              value="{{system.physical.durability.structureCurrent}}"
              data-value-type="nullable-number"
              data-document-field="system.physical.durability.structureCurrent"
            /></label>
          <label>PV structurels maximum<input
              type="number"
              min="0"
              step="any"
              value="{{system.physical.durability.structureMaximum}}"
              data-value-type="nullable-number"
              data-document-field="system.physical.durability.structureMaximum"
            /></label>
          <label>Seuil de brisure<input
              type="number"
              min="0"
              step="any"
              value="{{system.physical.durability.breakingThreshold}}"
              data-value-type="nullable-number"
              data-document-field="system.physical.durability.breakingThreshold"
            /></label>
          <label>Fiabilité 0–5<input
              type="number"
              min="0"
              max="5"
              step="1"
              value="{{system.physical.durability.reliability}}"
              data-value-type="nullable-number"
              data-document-field="system.physical.durability.reliability"
            /></label>
          <label>Durée de service<select
              data-document-field="system.physical.durability.serviceLife"
            >{{selectOptions
                durationOptions
                selected=system.physical.durability.serviceLife
              }}</select></label>
          <label>Intervalle de maintenance<select
              data-document-field="system.physical.durability.maintenanceInterval"
            >{{selectOptions
                durationOptions
                selected=system.physical.durability.maintenanceInterval
              }}</select></label>
          <label>Signature acoustique<select
              data-document-field="system.physical.durability.signature"
            >{{selectOptions
                acousticSignatureOptions
                selected=system.physical.durability.signature
              }}</select></label>
          <label>Chaleur actuelle<input
              type="number"
              min="0"
              step="any"
              value="{{system.physical.durability.heatCurrent}}"
              data-value-type="nullable-number"
              data-document-field="system.physical.durability.heatCurrent"
            /></label>
          <label>Chaleur maximale<input
              type="number"
              min="0"
              step="any"
              value="{{system.physical.durability.heatMaximum}}"
              data-value-type="nullable-number"
              data-document-field="system.physical.durability.heatMaximum"
            /></label>
        </div>
      </section>

      <section class="relis-card">
        <p class="relis-kicker">Exemplaire matériel</p>
        <h2>État physique</h2>
        <div class="relis-grid relis-grid--form relis-item-form">
          <label>
            Quantité
            <input
              type="number"
              min="0"
              step="any"
              value="{{system.physical.quantity}}"
              data-value-type="number"
              data-document-field="system.physical.quantity"
            />
          </label>
          <label>
            Unité
            <select data-document-field="system.physical.unit">
              {{selectOptions
                quantityUnitOptions
                selected=system.physical.unit
                valueAttr="value"
                labelAttr="label"
              }}
            </select>
          </label>
          <label>
            Masse unitaire
            <input
              type="number"
              min="0"
              step="any"
              value="{{system.physical.massEach}}"
              data-value-type="nullable-number"
              data-document-field="system.physical.massEach"
            />
          </label>
          <label>
            Volume unitaire
            <input
              type="number"
              min="0"
              step="any"
              value="{{system.physical.volumeEach}}"
              data-value-type="nullable-number"
              data-document-field="system.physical.volumeEach"
            />
          </label>
          <label>
            Encombrement unitaire
            <input
              type="number"
              min="0"
              step="any"
              value="{{system.physical.bulkEach}}"
              data-value-type="nullable-number"
              data-document-field="system.physical.bulkEach"
            />
          </label>
          <label>
            Localisation
            <input
              type="text"
              value="{{system.physical.locationKey}}"
              data-document-field="system.physical.locationKey"
            />
          </label>
          <label>
            Lot traçable
            <input
              type="text"
              value="{{system.provenance.lotId}}"
              data-document-field="system.provenance.lotId"
            />
          </label>
          <label>
            Relation de propriété
            <select data-document-field="system.physical.ownershipState">
              {{selectOptions
                ownershipOptions
                selected=system.physical.ownershipState
                valueAttr="value"
                labelAttr="label"
              }}
            </select>
          </label>
          <label>
            Accessibilité
            <select data-document-field="system.physical.accessibility">
              {{selectOptions
                accessibilityOptions
                selected=system.physical.accessibility
                valueAttr="value"
                labelAttr="label"
              }}
            </select>
          </label>
          <label>
            Expiration — affichage diégétique
            <input
              type="text"
              value="{{system.physical.expiresAt.displayOverride}}"
              data-document-field="system.physical.expiresAt.displayOverride"
            />
          </label>
          <label>
            Port
            {{#if isOwnedPhysical}}<span>{{equipmentLabel}}
                — utiliser le bouton d’état dans l’inventaire de l’Actor.</span>{{else}}
              <select data-document-field="system.physical.equipState">
                {{selectOptions
                  equipStateOptions
                  selected=selectedEquipState
                  valueAttr="value"
                  labelAttr="label"
                }}
              </select>
            {{/if}}
          </label>
          <label>
            État
            <select data-document-field="system.physical.condition">
              {{selectOptions
                conditionOptions
                selected=system.physical.condition
                valueAttr="value"
                labelAttr="label"
              }}
            </select>
          </label>
          <label>
            Usure
            <input
              type="number"
              min="0"
              max="6"
              value="{{system.physical.wear}}"
              data-value-type="number"
              data-document-field="system.physical.wear"
            />
          </label>
          <label class="relis-checkbox-field">
            <input
              type="checkbox"
              {{checked system.physical.identified}}
              data-value-type="boolean"
              data-document-field="system.physical.identified"
            />
            Identifié
          </label>
          <label>
            Charges actuelles
            <input
              type="number"
              min="0"
              value="{{system.physical.charges.current}}"
              data-value-type="nullable-number"
              data-document-field="system.physical.charges.current"
            />
          </label>
          <label>
            Charges maximum
            <input
              type="number"
              min="0"
              value="{{system.physical.charges.maximum}}"
              data-value-type="nullable-number"
              data-document-field="system.physical.charges.maximum"
            />
          </label>
        </div>
        <dl class="relis-item-totals">
          <div><dt>Masse totale</dt><dd>{{physicalTotals.mass}}</dd></div>
          <div><dt>Volume total</dt><dd>{{physicalTotals.volume}}</dd></div>
          <div><dt>Encombrement total</dt><dd>{{physicalTotals.bulk}}</dd></div>
        </dl>
        <p class="relis-scope-note">
          Piles, lots, conteneurs et transferts sont opératoires depuis
          l’inventaire de l’Actor. Porter, tenir, équiper et installer arrivent
          en 10-E3-P.
        </p>
      </section>
    {{/if}}

    {{#if isContainer}}
      <section class="relis-card">
        <p class="relis-kicker">Contraintes cumulatives</p>
        <h2>Conteneur</h2>
        <div class="relis-grid relis-grid--form relis-item-form">
          <label>
            Capacité de masse (kg)
            <input
              type="number"
              min="0"
              step="any"
              value="{{system.capacity.mass}}"
              data-value-type="nullable-number"
              data-document-field="system.capacity.mass"
            />
          </label>
          <label>
            Capacité de volume (L)
            <input
              type="number"
              min="0"
              step="any"
              value="{{system.capacity.volume}}"
              data-value-type="nullable-number"
              data-document-field="system.capacity.volume"
            />
          </label>
          <label>
            Capacité d’encombrement
            <input
              type="number"
              min="0"
              step="any"
              value="{{system.capacity.bulk}}"
              data-value-type="nullable-number"
              data-document-field="system.capacity.bulk"
            />
          </label>
          <label>
            Capacité en unités
            <input
              type="number"
              min="0"
              step="any"
              value="{{system.capacity.units}}"
              data-value-type="nullable-number"
              data-document-field="system.capacity.units"
            />
          </label>
          <label>
            Règle d’accès
            <select data-document-field="system.accessRule">
              {{selectOptions
                containerAccessOptions
                selected=system.accessRule
                valueAttr="value"
                labelAttr="label"
              }}
            </select>
          </label>
        </div>
        {{#if containerUsage}}
          <dl class="relis-item-totals">
            <div><dt>Masse contenue</dt><dd>{{containerUsage.mass}}</dd></div>
            <div><dt>Volume contenu</dt><dd>{{containerUsage.volume}}</dd></div>
            <div><dt>Encombrement contenu</dt><dd
              >{{containerUsage.bulk}}</dd></div>
            <div><dt>Unités contenues</dt><dd
              >{{containerUsage.units}}</dd></div>
          </dl>
        {{/if}}
      </section>
    {{/if}}

    {{#if isAction}}
      <section class="relis-card">
        <p class="relis-kicker">Compatibilité 10-C</p>
        <h2>Test de l’Action</h2>
        <div class="relis-grid relis-grid--form relis-item-form">
          <label>
            Attribut
            <select data-document-field="system.test.attributeKey">
              {{selectOptions
                attributes
                selected=system.test.attributeKey
                valueAttr="key"
                labelAttr="label"
              }}
            </select>
          </label>
          <label>
            Compétence
            <select data-document-field="system.test.skillKey">
              {{selectOptions
                skills
                selected=system.test.skillKey
                valueAttr="key"
                labelAttr="label"
              }}
            </select>
          </label>
          <label>
            Difficulté
            <input
              type="number"
              min="0"
              value="{{system.test.difficulty}}"
              data-value-type="number"
              data-document-field="system.test.difficulty"
            />
          </label>
          <label>
            Ressource technique
            <input
              type="text"
              value="{{system.test.resourceKey}}"
              data-document-field="system.test.resourceKey"
            />
          </label>
          <label>
            Coût
            <input
              type="number"
              min="0"
              value="{{system.test.cost}}"
              data-value-type="number"
              data-document-field="system.test.cost"
            />
          </label>
        </div>
        <h2>Effet temporaire</h2>
        <div class="relis-grid relis-grid--form relis-item-form">
          <label>
            Clé de condition
            <input
              type="text"
              value="{{system.effect.conditionKey}}"
              data-document-field="system.effect.conditionKey"
            />
          </label>
          <label>
            Intensité
            <input
              type="number"
              min="0"
              value="{{system.effect.intensity}}"
              data-value-type="number"
              data-document-field="system.effect.intensity"
            />
          </label>
          <label>
            Durée en rounds
            <input
              type="number"
              min="0"
              value="{{system.effect.durationRounds}}"
              data-value-type="number"
              data-document-field="system.effect.durationRounds"
            />
          </label>
        </div>
        <button type="button" data-action="test-item">
          <i class="fa-solid fa-dice-d20"></i>
          Tester l’Action
        </button>
      </section>
    {{/if}}

    <section class="relis-card relis-item-provenance">
      <p class="relis-kicker">Traçabilité</p>
      <h2>Provenance et versions</h2>
      <dl class="relis-fact-list">
        <div><span>Rôle</span><strong>{{itemRole}}</strong></div>
        <div><span>Identifiant RE:LIS</span><code
          >{{system.meta.relisId}}</code></div>
        <div><span>Schéma</span><strong
          >{{system.meta.schemaVersion}}</strong></div>
        <div><span>Règles</span><strong
          >{{system.meta.rulesVersion}}</strong></div>
        <div><span>Contenu</span><strong
          >{{system.meta.contentVersion}}</strong></div>
        <div><span>Révision locale</span><strong
          >{{system.provenance.localRevision}}</strong></div>
        <div><span>Acquisition</span><strong
          >{{system.provenance.acquisitionKind}}</strong></div>
        <div><span>Lot</span><strong>{{system.provenance.lotId}}</strong></div>
      </dl>
      {{#if hasSourceRef}}
        <details>
          <summary>Référence de source</summary>
          <dl class="relis-fact-list">
            <div><span>Identifiant</span><code
              >{{system.meta.sourceRef.relisId}}</code></div>
            <div><span>UUID mémorisé</span><code
              >{{system.meta.sourceRef.uuid}}</code></div>
            <div><span>Version copiée</span><strong
              >{{system.meta.sourceVersion}}</strong></div>
            <div><span>Libellé mémorisé</span><strong
              >{{system.meta.sourceRef.labelSnapshot}}</strong></div>
          </dl>
        </details>
      {{/if}}
      {{#if manualOverrides.length}}
        <details>
          <summary>{{manualOverrides.length}}
            champ(s) modifié(s) localement</summary>
          <ul>
            {{#each manualOverrides}}<li><code>{{this}}</code></li>{{/each}}
          </ul>
        </details>
      {{/if}}
    </section>
  </div>

  <footer class="relis-sheet-footer">
    10-E3-P validé · profils 10-E4-P en recette · paquet
    {{packageVersion}}
  </footer>
</section>