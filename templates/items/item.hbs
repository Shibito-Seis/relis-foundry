<section
  class="relis-sheet relis-sheet--item relis-item-sheet"
  data-document-id="{{item.id}}"
>
  <header class="relis-item-header">
    <button
      class="relis-item-icon"
      type="button"
      data-action="edit-image"
      title="Choisir l’illustration"
      aria-label="Choisir l’illustration de {{item.name}}"
    >
      <img src="{{item.img}}" alt="Illustration de {{item.name}}" />
      <span class="relis-item-icon-action" aria-hidden="true">
        <i class="fa-solid fa-image"></i>
      </span>
    </button>
    <div class="relis-item-heading">
      <p class="relis-kicker">RE:LIS — {{itemTypeLabel}}</p>
      <input
        class="relis-name"
        type="text"
        value="{{item.name}}"
        data-document-field="name"
      />
      <div class="relis-trait-bar" aria-label="Traits de l’Item">
        <span class="relis-trait-bar-label">Traits</span>
        {{#if canEditTraits}}
          <multi-select
            class="relis-trait-selector"
            name="system.traits"
            data-trait-selector
          >
            {{#each traitOptions}}
              {{#if this.selected}}
                <option
                  value="{{this.value}}"
                  selected
                  data-selected-trait
                >{{this.label}}</option>
              {{else}}
                <option value="{{this.value}}">{{this.label}}</option>
              {{/if}}
            {{/each}}
          </multi-select>
        {{else}}
          <div class="relis-trait-readonly">
            {{#each selectedTraits}}
              <span class="relis-trait-chip">{{this.label}}</span>
            {{else}}
              <span class="relis-trait-empty">Aucun trait</span>
            {{/each}}
          </div>
        {{/if}}
      </div>
    </div>
    <div class="relis-item-badges" aria-label="État de l’Item">
      {{#each badges}}
        <span class="relis-state-chip {{this.className}}">{{this.label}}</span>
      {{/each}}
    </div>
  </header>

  {{#if diagnostics.length}}
    <aside class="relis-item-diagnostics" aria-label="Diagnostics">
      {{#each diagnostics}}
        <p class="relis-item-diagnostic relis-item-diagnostic--{{this.level}}">
          <i class="fa-solid {{this.icon}}"></i>
          {{this.message}}
        </p>
      {{/each}}
    </aside>
  {{/if}}

  <div class="relis-item-layout">
    <section class="relis-card relis-item-description-card">
      <p class="relis-kicker">Contenu commun</p>
      <div class="relis-section-heading relis-description-heading">
        <h2>Description</h2>
        {{#if canManageDescriptionPermission}}
          <label class="relis-description-permission">
            <input
              type="checkbox"
              {{checked system.permissions.playerEditableDescription}}
              data-value-type="boolean"
              data-document-field="system.permissions.playerEditableDescription"
            />
            Autoriser le propriétaire PJ à modifier
          </label>
        {{/if}}
      </div>
      <div class="relis-item-description">
        <div
          class="relis-description-editor-host"
          data-description-editor-host
        ></div>
      </div>
      <div class="relis-item-ref-summary">
        <span>{{requirementCount}} prérequis référencé(s)</span>
        <span>{{effectRefCount}} effet(s) référencé(s)</span>
      </div>
    </section>

    {{#if hasCatalog}}
      <section class="relis-card">
        <p class="relis-kicker">Valeurs stables</p>
        <h2>Catalogue</h2>
        <div class="relis-grid relis-grid--form relis-item-form">
          {{#if applicability.level}}
            <label>
              Niveau
              <input
                type="number"
                min="1"
                max="30"
                value="{{system.level}}"
                data-value-type="nullable-number"
                data-document-field="system.level"
              />
            </label>
          {{/if}}
          {{#if applicability.quality}}
            <label>
              Qualité
              <select
                data-document-field="system.quality"
                data-value-type="nullable-number"
              >
                {{selectOptions
                  qualityOptions
                  selected=system.quality
                  valueAttr="value"
                  labelAttr="label"
                }}
              </select>
            </label>
          {{/if}}
          {{#if applicability.rarity}}
            <label>
              Rareté
              <select
                data-document-field="system.rarity"
                data-value-type="nullable-number"
              >
                {{selectOptions
                  rarityOptions
                  selected=system.rarity
                  valueAttr="value"
                  labelAttr="label"
                }}
              </select>
            </label>
          {{/if}}
          {{#if applicability.legality}}
            <label>
              Légalité
              <select data-document-field="system.legality">
                {{selectOptions
                  legalityOptions
                  selected=system.legality
                  valueAttr="value"
                  labelAttr="label"
                }}
              </select>
            </label>
          {{/if}}
          {{#if applicability.manufacturer}}
            <label>
              Fabricant — identifiant durable
              <input
                type="text"
                value="{{system.manufacturerRef.relisId}}"
                data-document-field="system.manufacturerRef.relisId"
              />
            </label>
            <label>
              Fabricant — libellé mémorisé
              <input
                type="text"
                value="{{system.manufacturerRef.labelSnapshot}}"
                data-document-field="system.manufacturerRef.labelSnapshot"
              />
            </label>
          {{/if}}
        </div>
        {{#if applicability.referencePrice}}
          <h2>Prix de référence</h2>
          <p class="relis-scope-note">
            Valeur de catalogue uniquement. Les devis datés et locaux
            appartiennent aux marchés de 10-J.
          </p>
          <div class="relis-grid relis-grid--form relis-item-form">
            <label>
              Montant
              <input
                type="number"
                min="0"
                step="any"
                value="{{system.referencePrice.amount}}"
                data-value-type="nullable-number"
                data-document-field="system.referencePrice.amount"
              />
            </label>
            <label>
              Pour une quantité de
              <input
                type="number"
                min="0.000001"
                step="any"
                value="{{system.referencePrice.quantityBasis}}"
                data-value-type="number"
                data-document-field="system.referencePrice.quantityBasis"
              />
            </label>
            <label>
              Unité de prix
              <input
                type="text"
                value="{{system.referencePrice.unit}}"
                data-document-field="system.referencePrice.unit"
              />
            </label>
            <label>
              Monnaie — identifiant durable
              <input
                type="text"
                value="{{system.referencePrice.currencyRef.relisId}}"
                data-document-field="system.referencePrice.currencyRef.relisId"
              />
            </label>
          </div>
        {{/if}}
      </section>
    {{/if}}

    {{#if hasPhysical}}
      {{#if showsEquipmentProfile}}
        <section
          class="relis-card relis-equipment-profile"
          data-equipment-profile
        >
          <p class="relis-kicker">Propriétés de l’objet</p>
          <h2>Usage et compatibilités</h2>
          <fieldset>
            <legend>Classification de cet objet</legend>
            <div class="relis-grid relis-grid--form">
              {{#if isEquipment}}<label>Famille fonctionnelle<select
                    data-profile-field="functionalCategory"
                  >{{selectOptions
                      functionalCategories
                      selected=system.physical.equipmentProfile.functionalCategory
                    }}</select></label>{{/if}}
              <label>Forme de port — un seul choix<select
                  data-profile-field="wearForm"
                >{{selectOptions
                    wearFormOptions
                    selected=system.physical.equipmentProfile.wearForm
                  }}</select></label>
              {{#if isEquipment}}<label data-piercing-fields>Emplacement du
                  piercing<select
                    data-profile-field="piercingLocation"
                  >{{selectOptions
                      piercingLocations
                      selected=system.physical.equipmentProfile.piercingLocation
                      blank="Choisir un emplacement"
                    }}</select></label>{{/if}}
              {{#if isEquipment}}{{#if profileIsGM}}<label><input
                      type="checkbox"
                      data-profile-field="ornamental"
                      {{checked system.physical.equipmentProfile.ornamental}}
                    />Ornement purement esthétique, sans bonus ni place
                    mécanique</label>{{/if}}{{/if}}
              {{#if isWeapon}}<label data-shield-fields>Mains nécessaires pour
                  porter ce bouclier<input
                    type="number"
                    min="0"
                    max="2"
                    step="1"
                    data-profile-field="shieldHands"
                    value="{{system.physical.equipmentProfile.shieldHands}}"
                  />Selon sa source ; vide = non renseigné, 0 = fixation
                  explicitement prévue.</label>{{/if}}
            </div>
            <p>Les vêtements et accessoires sans quota restent décrits par leur
              forme. Un piercing à bonus exige une capacité définie pour son
              emplacement sur le corps ; aucune anatomie n’est supposée.</p>
          </fieldset>
          {{#if profileLocked}}<p>Profil composé défini par le MJ : utilisable
              depuis l’inventaire, modification réservée au MJ.</p>{{/if}}

          <div class="relis-grid relis-grid--form relis-item-form">
            {{#if isEquipment}}<label>Usage<select data-profile-field="family">
                  {{selectOptions
                    equipmentFamilies
                    selected=system.physical.equipmentProfile.family
                  }}
                </select></label>{{/if}}
            {{#if isEquipment}}<label>Temps et aide nécessaires<select
                  data-profile-field="duration"
                >{{selectOptions
                    durationOptions
                    selected=system.physical.equipmentProfile.duration
                  }}</select></label>{{/if}}
            <label>Nature d’installation<select
                data-profile-field="installationKind"
              >{{selectOptions
                  installationKindOptions
                  selected=system.physical.equipmentProfile.installationKind
                }}</select></label>
            <label><input
                type="checkbox"
                data-profile-field="installable"
                {{checked system.physical.equipmentProfile.installable}}
              />
              Installable sur un autre objet</label>
            {{#if isEquipment}}<label><input
                  type="checkbox"
                  data-profile-field="ordinaryLiquid"
                  {{checked system.physical.equipmentProfile.ordinaryLiquid}}
                />
                Liquide ordinaire : 1 L ≈ 1 kg si masse absente</label>{{/if}}
          </div>
          {{#each equipmentProfileGroups}}
            <fieldset data-profile-group="{{key}}" {{hiddenAttribute}}><legend
              >{{title}}</legend>
              <p>{{#if count}}{{count}}
                  choix enregistré(s).{{else}}{{emptyLabel}}{{/if}}</p>
              <div class="relis-profile-choices">
                {{#each choices}}<label><input
                      type="checkbox"
                      data-profile-list="{{groupKey}}"
                      value="{{value}}"
                      {{checked checked}}
                    />
                    {{label}}</label>{{#if isBodySlot}}{{#if
                      @root.profileIsGM
                    }}<label>Places<input
                          type="number"
                          min="1"
                          step="1"
                          data-profile-cost="{{value}}"
                          value="{{units}}"
                        /></label>{{/if}}{{/if}}{{/each}}
              </div>
            </fieldset>
          {{/each}}
          {{#if equipmentSlotErrors}}
            <aside class="relis-inventory-diagnostics">{{#each
                equipmentSlotErrors
              }}<p>{{this}}</p>{{/each}}
              Les anciennes valeurs sont conservées jusqu’à l’enregistrement de
              vos choix corrigés sur cet objet.
            </aside>
          {{/if}}
          <p>Ces choix concernent uniquement cet objet.
            {{equipmentSlotHint}}</p>
          <p>Seul un profil composé défini par le MJ occupe plusieurs places.
            L’occupation ne décrit pas les zones protégées. Tailles et natures
            vides : aucune restriction déclarée.</p>
          {{#if legacyEquipmentSlot}}<aside
              class="relis-inventory-diagnostics"
            >Ancien emplacement conservé :
              {{legacyEquipmentSlot}}. Reconfigurez les choix ci-dessus et les
              besoins techniques ci-dessous, puis enregistrez. Aucune conversion
              automatique.
              <label><input type="checkbox" data-legacy-slots-confirm />
                Je remplace l’ancien emplacement par les choix corporels et
                techniques de cette fiche, y compris si je les laisse vides.</label>
            </aside>{{/if}}
          <details class="relis-technical-slots"><summary>Installation et
              accueil de modules — détails</summary>
            <p>Fourni : capacité de cet objet comme hôte. Requis : quantité
              occupée sur l’hôte lorsque cet objet est installé. Zéro signifie
              aucun. Vérifier aussi les compatibilités déclarées par la source
              de l’objet.</p>
            <div class="relis-grid relis-grid--form relis-item-form">
              <label>Technologie de l’hôte<select
                  data-profile-field="technologyId"
                >{{selectOptions
                    technologyOptions
                    selected=system.physical.equipmentProfile.technologyId
                  }}</select></label>
              <label>Gabarit technique de l’hôte<select
                  data-profile-field="technicalSizeId"
                >{{selectOptions
                    technicalSizeOptions
                    selected=system.physical.equipmentProfile.technicalSizeId
                  }}</select></label>
              <label>Interfaces offertes<multi-select
                  name="system.physical.equipmentProfile.interfaceIds"
                  data-profile-field="interfaceIds"
                  data-profile-value-type="string-set"
                >{{selectOptions
                    technicalInterfaceOptions
                    selected=system.physical.equipmentProfile.interfaceIds
                  }}</multi-select></label>
              <label>Familles d’hôte compatibles<multi-select
                  name="system.physical.equipmentProfile.compatibleFamilies"
                  data-profile-field="compatibleFamilies"
                  data-profile-value-type="string-set"
                >{{selectOptions
                    materialFamilyOptions
                    selected=system.physical.equipmentProfile.compatibleFamilies
                  }}</multi-select></label>
              <label>Gabarits d’hôte compatibles<multi-select
                  name="system.physical.equipmentProfile.compatibleSizes"
                  data-profile-field="compatibleSizes"
                  data-profile-value-type="string-set"
                >{{selectOptions
                    technicalSizeOptions
                    selected=system.physical.equipmentProfile.compatibleSizes
                  }}</multi-select></label>
              <label>Technologies d’hôte compatibles<multi-select
                  name="system.physical.equipmentProfile.compatibleTechnologies"
                  data-profile-field="compatibleTechnologies"
                  data-profile-value-type="string-set"
                >{{selectOptions
                    technologyOptions
                    selected=system.physical.equipmentProfile.compatibleTechnologies
                  }}</multi-select></label>
              <label>Interfaces d’hôte compatibles<multi-select
                  name="system.physical.equipmentProfile.compatibleInterfaces"
                  data-profile-field="compatibleInterfaces"
                  data-profile-value-type="string-set"
                >{{selectOptions
                    technicalInterfaceOptions
                    selected=system.physical.equipmentProfile.compatibleInterfaces
                  }}</multi-select></label>
            </div>
            <div class="relis-slot-grid"><b>Type</b><b>Places offertes par cet
                objet</b><b>Places nécessaires pour installer cet objet</b>
              {{#each technicalSlotRows}}
                <span>{{label}}</span>
                <label><span class="relis-slot-input-label">{{label}}
                    fourni</span><input
                    type="number"
                    min="0"
                    step="1"
                    value="{{provided}}"
                    data-profile-technical="providedSlots"
                    data-slot-key="{{key}}"
                  /></label>
                <label><span class="relis-slot-input-label">{{label}}
                    requis</span><input
                    type="number"
                    min="0"
                    step="1"
                    value="{{required}}"
                    data-profile-technical="requiredSlots"
                    data-slot-key="{{key}}"
                  /></label>
              {{/each}}</div>
          </details>
          {{#if editable}}<button
              type="button"
              data-save-equipment-profile
            >Enregistrer les propriétés d’équipement</button><p
              data-profile-status
              role="status"
            >Propriétés enregistrées affichées.</p>{{/if}}
        </section>
      {{/if}}

      {{#if isWeapon}}
        <section class="relis-card relis-material-profile">
          <p class="relis-kicker">Profil canonique 10-E4-P</p>
          <h2>Arme</h2>
          <p class="relis-scope-note">La fiche ne propose que les registres
            applicables aux armes. Les jets d’attaque, dégâts et blessures
            seront automatisés en 10-F.</p>
          <div class="relis-grid relis-grid--form relis-item-form">
            <label>Famille<select
                data-document-field="system.weaponProfile.familyId"
              >{{selectOptions
                  weaponFamilyOptions
                  selected=system.weaponProfile.familyId
                }}</select></label>
            {{#if isTechnoBladeFamily}}
              <label>Variante de techno-lame<select
                  data-document-field="system.weaponProfile.technoBladeVariant"
                >{{selectOptions
                    technoBladeOptions
                    selected=system.weaponProfile.technoBladeVariant
                  }}</select></label>
            {{/if}}
            <label>Support<select
                data-document-field="system.weaponProfile.support"
              >{{selectOptions
                  weaponSupportOptions
                  selected=system.weaponProfile.support
                }}</select></label>
            <label>Accès<select
                data-document-field="system.weaponProfile.access"
              >{{selectOptions
                  accessOptions
                  selected=system.weaponProfile.access
                }}</select></label>
            <label>Défense visée<select
                data-document-field="system.weaponProfile.defenseTarget"
              >{{selectOptions
                  defenseTargetOptions
                  selected=system.weaponProfile.defenseTarget
                }}</select></label>
            <label>Mains requises<select
                data-document-field="system.weaponProfile.handsMode"
              >{{selectOptions
                  weaponHandsOptions
                  selected=system.weaponProfile.handsMode
                }}</select></label>
            <label>Compétence<select
                data-document-field="system.weaponProfile.skillId"
              >{{selectOptions
                  weaponSkillOptions
                  selected=system.weaponProfile.skillId
                }}</select></label>
            <label>Attribut<select
                data-document-field="system.weaponProfile.attributeId"
              >{{selectOptions
                  weaponAttributeOptions
                  selected=system.weaponProfile.attributeId
                }}</select></label>
            <label>Précision<select
                data-document-field="system.weaponProfile.accuracy"
                data-value-type="nullable-number"
              >{{selectOptions
                  accuracyOptions
                  selected=system.weaponProfile.accuracy
                  valueAttr="value"
                  labelAttr="label"
                }}</select></label>
            <label>Nombre de dés fondamentaux<input
                type="number"
                min="1"
                max="5"
                step="1"
                value="{{system.weaponProfile.damageDice}}"
                data-value-type="nullable-number"
                data-document-field="system.weaponProfile.damageDice"
              /></label>
            <label>Dé fondamental<select
                data-document-field="system.weaponProfile.damageDie"
              >{{selectOptions
                  damageDieOptions
                  selected=system.weaponProfile.damageDie
                }}</select></label>
            <label>Bonus fixe aux dégâts<input
                type="number"
                min="-20"
                max="20"
                step="1"
                value="{{system.weaponProfile.damageBonus}}"
                data-value-type="nullable-number"
                data-document-field="system.weaponProfile.damageBonus"
              /></label>
            <label>Attribut aux dégâts<select
                data-document-field="system.weaponProfile.damageAttribute"
              >{{selectOptions
                  damageAttributeOptions
                  selected=system.weaponProfile.damageAttribute
                }}</select></label>
            <label>Types de dégâts<multi-select
                name="system.weaponProfile.damageTypes"
                data-document-field="system.weaponProfile.damageTypes"
                data-value-type="string-set"
              >{{selectOptions
                  damageTypeOptions
                  selected=system.weaponProfile.damageTypes
                }}</multi-select></label>
            <label>Sources des dégâts<multi-select
                name="system.weaponProfile.damageSources"
                data-document-field="system.weaponProfile.damageSources"
                data-value-type="string-set"
              >{{selectOptions
                  damageSourceOptions
                  selected=system.weaponProfile.damageSources
                }}</multi-select></label>
            <label>Pénétration<input
                type="number"
                min="0"
                step="1"
                value="{{system.weaponProfile.penetration}}"
                data-value-type="nullable-number"
                data-document-field="system.weaponProfile.penetration"
              /></label>
            <label>Type de portée<select
                data-document-field="system.weaponProfile.rangeKind"
              >{{selectOptions
                  rangeKindOptions
                  selected=system.weaponProfile.rangeKind
                }}</select></label>
            <label>Portée optimale en mètres<input
                type="number"
                min="0"
                step="any"
                value="{{system.weaponProfile.rangeOptimal}}"
                data-value-type="nullable-number"
                data-document-field="system.weaponProfile.rangeOptimal"
              /></label>
            <label>Portée maximale en mètres<input
                type="number"
                min="0"
                step="any"
                value="{{system.weaponProfile.rangeMaximum}}"
                data-value-type="nullable-number"
                data-document-field="system.weaponProfile.rangeMaximum"
              /></label>
            <label>Allonge en cases<input
                type="number"
                min="0"
                step="any"
                value="{{system.weaponProfile.reach}}"
                data-value-type="nullable-number"
                data-document-field="system.weaponProfile.reach"
              /></label>
            <label>Cadence<select
                data-document-field="system.weaponProfile.cadenceId"
              >{{selectOptions
                  cadenceOptions
                  selected=system.weaponProfile.cadenceId
                }}</select></label>
            <label>Recul<select
                data-document-field="system.weaponProfile.recoil"
                data-value-type="nullable-number"
              >{{selectOptions
                  recoilOptions
                  selected=system.weaponProfile.recoil
                  valueAttr="value"
                  labelAttr="label"
                }}</select></label>
            <label>Modes de tir<multi-select
                name="system.weaponProfile.modeIds"
                data-document-field="system.weaponProfile.modeIds"
                data-value-type="string-set"
              >{{selectOptions
                  fireModeOptions
                  selected=system.weaponProfile.modeIds
                }}</multi-select></label>
            <label>Signature acoustique<select
                data-document-field="system.weaponProfile.acousticSignature"
              >{{selectOptions
                  acousticSignatureOptions
                  selected=system.weaponProfile.acousticSignature
                }}</select></label>
            <label>Autres signatures<multi-select
                name="system.weaponProfile.signatureIds"
                data-document-field="system.weaponProfile.signatureIds"
                data-value-type="string-set"
              >{{selectOptions
                  signatureTagOptions
                  selected=system.weaponProfile.signatureIds
                }}</multi-select></label>
          </div>
          <h3>Alimentation et rechargement</h3>
          <div class="relis-grid relis-grid--form relis-item-form">
            <label>Mode d’alimentation<select
                data-document-field="system.weaponProfile.feedKind"
              >{{selectOptions
                  feedKindOptions
                  selected=system.weaponProfile.feedKind
                }}</select></label>
            <label>Familles de munitions ou sources compatibles<multi-select
                name="system.weaponProfile.ammunitionFamilyIds"
                data-document-field="system.weaponProfile.ammunitionFamilyIds"
                data-value-type="string-set"
              >{{selectOptions
                  weaponAmmunitionFamilyOptions
                  selected=system.weaponProfile.ammunitionFamilyIds
                }}</multi-select></label>
            {{#if usesProjectileFeed}}
              <label>Chambrage exact<select
                  data-document-field="system.weaponProfile.chamberingId"
                >{{selectOptions
                    chamberingOptions
                    selected=system.weaponProfile.chamberingId
                  }}</select></label>
              <label>Classe de pression<select
                  data-document-field="system.weaponProfile.pressureClassId"
                >{{selectOptions
                    pressureClassOptions
                    selected=system.weaponProfile.pressureClassId
                  }}</select></label>
              <label>Interface d’alimentation<select
                  data-document-field="system.weaponProfile.feedInterfaceId"
                >{{selectOptions
                    feedInterfaceOptions
                    selected=system.weaponProfile.feedInterfaceId
                  }}</select></label>
            {{/if}}
            {{#if showsWeaponCapacity}}
              <label>Capacité<input
                  type="number"
                  min="0"
                  step="1"
                  value="{{system.weaponProfile.capacity}}"
                  data-value-type="nullable-number"
                  data-document-field="system.weaponProfile.capacity"
                /></label>
              <label>Consommation ordinaire<input
                  type="number"
                  min="0"
                  step="any"
                  value="{{system.weaponProfile.consumption}}"
                  data-value-type="nullable-number"
                  data-document-field="system.weaponProfile.consumption"
                /></label>
              <label>Actions de recharge ordinaires<input
                  type="number"
                  min="0"
                  step="any"
                  value="{{system.weaponProfile.reloadActions}}"
                  data-value-type="nullable-number"
                  data-document-field="system.weaponProfile.reloadActions"
                /></label>
            {{/if}}
            {{#if usesProjectileFeed}}<label><input
                  type="checkbox"
                  {{checked system.weaponProfile.chamberSeparate}}
                  data-value-type="boolean"
                  data-document-field="system.weaponProfile.chamberSeparate"
                />Chambre suivie séparément si la source le prévoit</label>{{/if}}
          </div>
          {{#if usesEnergyFeed}}<p class="relis-scope-note">Cette arme utilise
              une batterie ou cellule. Son format, sa classe de puissance et sa
              charge se règlent uniquement dans le bloc énergétique de cette
