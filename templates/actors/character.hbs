<section
  class="relis-sheet relis-person-sheet relis-person-sheet--{{actor.type}}"
  data-document-id="{{actor.id}}"
>
  <header class="relis-id-header">
    <div class="relis-portrait-controls">
      <button
        type="button"
        class="relis-id-portrait"
        data-action="showPortraitArtwork"
        title="Afficher le portrait de {{displayName}}"
        aria-label="Afficher le portrait de {{displayName}}"
      >
        <span class="relis-id-portrait__ring" aria-hidden="true"></span>
        <span class="relis-id-portrait__core">
          <img src="{{actor.img}}" alt="Portrait de {{displayName}}" />
        </span>
        <span class="relis-id-portrait__status" title="Dossier actif"></span>
      </button>
      {{#if editable}}<button
          type="button"
          class="relis-edit-portrait"
          data-edit-actor-portrait
          data-owner-control
          title="Choisir le portrait de {{displayName}}"
        ><i class="fa-solid fa-pen" aria-hidden="true"></i>
          Modifier le portrait</button>{{/if}}
    </div>

    <div class="relis-id-frame">
      <div class="relis-id-panel">
        <div class="relis-id-titleline">
          <div>
            <p class="relis-kicker">RE:LIS · {{actorTypeLabel}}</p>
            <input
              class="relis-name"
              type="text"
              value="{{actor.name}}"
              data-document-field="name"
              aria-label="Nom de l’Actor"
            />
          </div>
          <span class="relis-state-chip">Modèle 10-D2</span>
        </div>

        {{#if isCharacter}}
          <dl class="relis-id-facts">
            <div><dt>Nom public</dt><dd>{{displayName}}</dd></div>
            <div><dt>Niveau</dt><dd>{{system.level}}</dd></div>
            <div><dt>Corps actif</dt><dd>{{activeBody.name}}</dd></div>
            <div><dt>Nature</dt><dd>{{activeBodyNatureLabel}}</dd></div>
          </dl>
        {{else}}
          <dl class="relis-id-facts">
            <div><dt>Désignation</dt><dd>{{displayName}}</dd></div>
            <div><dt>Densité</dt><dd>{{npcDetailLevel}}</dd></div>
            <div><dt>Rôle</dt><dd>{{system.role}}</dd></div>
            <div><dt>Corps actif</dt><dd>{{activeBody.name}}</dd></div>
          </dl>
        {{/if}}
      </div>
    </div>
  </header>

  <section class="relis-resource-strip" aria-label="Résumé des ressources">
    {{#if isPerson}}
      <div class="relis-resource relis-resource--vital">
        <span>PV</span><strong>{{system.health.hitPoints.current}}</strong>
        <small>/ {{system.health.hitPoints.maximum}}</small>
      </div>
      <div class="relis-resource relis-resource--mental">
        <span>Stress</span><strong>{{stress.value}}</strong>
        <small>/ {{stress.max}}</small>
      </div>
      <div class="relis-resource">
        <span>Fatigue</span><strong>{{system.health.fatigue}}</strong>
        <small>/ 5</small>
      </div>
      {{#if system.defenses.cap}}
        <div class="relis-resource"><span>CAP</span><strong
          >{{system.defenses.cap}}</strong></div>
      {{/if}}
      {{#if system.defenses.cae}}
        <div class="relis-resource"><span>CAE</span><strong
          >{{system.defenses.cae}}</strong></div>
      {{/if}}
      {{#each energyPools}}
        <div class="relis-resource {{resourceClass}}">
          <span>{{label}}</span><strong>{{current}}</strong><small>/
            {{maximum}}</small>
        </div>
      {{/each}}
      <div class="relis-resource"><span>Effets</span><strong
        >{{effectCount}}</strong></div>
      <div class="relis-resource"><span>Items</span><strong
        >{{itemCount}}</strong></div>
    {{/if}}
  </section>

  <nav class="relis-tabs" role="tablist" aria-label="Sections de la fiche">
    {{#each tabs}}
      <button
        type="button"
        role="tab"
        id="relis-tab-{{id}}"
        aria-controls="relis-panel-{{id}}"
        aria-selected="{{active}}"
        tabindex="{{tabIndex}}"
        data-action="switch-tab"
        data-tab-id="{{id}}"
      >{{label}}</button>
    {{/each}}
  </nav>

  <main class="relis-tab-content">
    {{#if isCharacter}}
      <section
        class="relis-tab-panel"
        id="relis-panel-summary"
        role="tabpanel"
        aria-labelledby="relis-tab-summary"
        data-tab-panel="summary"
      >
        <div class="relis-dashboard-grid">
          <article class="relis-card relis-card--wide">
            <div class="relis-section-heading">
              <div><p class="relis-kicker">Aperçu opérationnel</p><h2
                >Synthèse</h2></div>
              <label class="relis-compact-field">DD d’essai<input
                  type="number"
                  min="0"
                  value="15"
                  data-test-difficulty
                /></label>
            </div>
            <div class="relis-fact-list">
              <div><span>Intégrité</span><strong
                >{{system.health.hitPoints.current}}
                  /
                  {{system.health.hitPoints.maximum}}
                  PV</strong></div>
              <div><span>Effets actifs</span><strong
                >{{effectCount}}</strong></div>
              <div><span>Items embarqués</span><strong
                >{{itemCount}}</strong></div>
              <div><span>Stress</span><strong>{{stress.value}}
                  /
                  {{stress.max}}</strong></div>
              <div><span>Fatigue</span><strong>{{system.health.fatigue}}
                  / 5</strong></div>
            </div>
          </article>
          <article class="relis-card">
            <p class="relis-kicker">Accès rapide</p><h2>Compétences</h2>
            <div class="relis-list relis-list--compact">
              {{#each featuredSkills}}
                <button
                  type="button"
                  class="relis-quick-roll"
                  data-action="roll-skill"
                  data-skill-key="{{key}}"
                  data-owner-control
                >
                  <i class="fa-solid fa-dice-d20" aria-hidden="true"></i><span
                  >{{label}}</span><strong>{{total}}</strong>
                </button>
              {{/each}}
            </div>
          </article>
          <article class="relis-card">
            <p class="relis-kicker">Contexte</p><h2>Situation</h2>
            <div class="relis-empty-state relis-empty-state--small"><i
                class="fa-solid fa-location-crosshairs"
                aria-hidden="true"
              ></i><p>Scène, Rencontre, poste et alertes seront raccordés dans
                les lots concernés.</p></div>
          </article>
        </div>
      </section>

      <section
        class="relis-tab-panel"
        id="relis-panel-identity"
        role="tabpanel"
        aria-labelledby="relis-tab-identity"
        data-tab-panel="identity"
        hidden
      >
        <div class="relis-content-grid">
          <article class="relis-card">
            <p class="relis-kicker">Dossier civil</p><h2>Identité</h2>
            <div class="relis-grid relis-grid--form">
              <label>Nom principal<input
                  type="text"
                  value="{{system.identity.primaryName}}"
                  data-document-field="system.identity.primaryName"
                /></label>
              <label>Nom public<input
                  type="text"
                  value="{{system.identity.publicName}}"
                  data-document-field="system.identity.publicName"
                /></label>
              <label>Pronoms<input
                  type="text"
                  value="{{system.identity.pronouns}}"
                  data-document-field="system.identity.pronouns"
                /></label>
              <label>Genre<input
                  type="text"
                  value="{{system.identity.gender}}"
                  data-document-field="system.identity.gender"
                /></label>
              <label>Indicatif<input
                  type="text"
                  value="{{system.identity.callsign}}"
                  data-document-field="system.identity.callsign"
                /></label>
              <label>Corps actif<select
                  data-document-field="system.activeBodyId"
                >{{selectOptions
                    bodies
                    selected=system.activeBodyId
                    valueAttr="id"
                    labelAttr="name"
                  }}</select></label>
            </div>
          </article>
          <article class="relis-card">
            <p class="relis-kicker">Apparence actuelle</p><h2>Corps & identité
              visible</h2>
            <div class="relis-grid relis-grid--form">
              <label>Nature<input
                  type="text"
                  value="{{activeBodyNatureLabel}}"
                  disabled
                /></label>
              <label>Taille du corps<input
                  type="text"
                  value="{{activeBody.size}}"
                  disabled
                /></label>
              <label>Corpulence<input
                  type="text"
                  value="{{system.identity.appearance.build}}"
                  data-document-field="system.identity.appearance.build"
                /></label>
              <label>Yeux ou capteurs<input
                  type="text"
                  value="{{system.identity.appearance.eyes}}"
                  data-document-field="system.identity.appearance.eyes"
                /></label>
              <label>Voix<input
                  type="text"
                  value="{{system.identity.appearance.voice}}"
                  data-document-field="system.identity.appearance.voice"
                /></label>
              <label>Signes distinctifs<input
                  type="text"
                  value="{{system.identity.appearance.distinctiveMarks}}"
                  data-document-field="system.identity.appearance.distinctiveMarks"
                /></label>
            </div>
            <p class="relis-scope-note">La gestion de plusieurs Corps,
              Présences, portraits et Tokens reste réservée à 10-D5. Le modèle
              10-D2 en conserve déjà les identifiants sans dupliquer les
              ressources personnelles.</p>
          </article>
          <article class="relis-card relis-card--wide">
            <p class="relis-kicker">Repères temporels distincts</p><h2>Âges</h2>
            <div class="relis-grid relis-grid--ages">
              <label>Date de naissance terrienne<input
                  type="text"
                  value="{{system.age.earthBirthDate}}"
                  data-document-field="system.age.earthBirthDate"
                /></label>
              <label>Âge chronologique<input
                  type="number"
                  min="0"
                  value="{{system.age.chronological.value}}"
                  data-value-type="number"
                  data-document-field="system.age.chronological.value"
                /></label>
              <label>Âge biologique<input
                  type="number"
                  min="0"
                  value="{{system.age.biological.value}}"
                  data-value-type="number"
                  data-document-field="system.age.biological.value"
                /></label>
              <label>Âge apparent<input
                  type="number"
                  min="0"
                  value="{{system.age.apparent.value}}"
                  data-value-type="number"
                  data-document-field="system.age.apparent.value"
                /></label>
            </div>
          </article>
        </div>
      </section>

      <section
        class="relis-tab-panel"
        id="relis-panel-attributes"
        role="tabpanel"
        aria-labelledby="relis-tab-attributes"
        data-tab-panel="attributes"
        hidden
      >
        <div class="relis-columns">
          <article class="relis-card">
            <p class="relis-kicker">Valeurs fondamentales</p><h2>Attributs</h2>
            <div class="relis-list">
              {{#each attributes}}
                <div class="relis-row relis-row--attribute">
                  <span>{{label}}</span><span
                    class="relis-derived"
                    title="Valeur effective"
                  >{{effective}}</span>
                  <input
                    type="number"
                    min="-5"
                    max="8"
                    value="{{base}}"
                    data-value-type="number"
                    data-document-field="system.attributes.{{key}}.base"
                    aria-label="Valeur de base : {{label}}"
                  />
                  <label
                    class="relis-partial"
                    title="Valeur partielle +"
                  >+<input
                      type="checkbox"
                      {{checked partial}}
                      data-document-field="system.attributes.{{key}}.partial"
                      aria-label="Valeur partielle pour {{label}}"
                    /></label>
                </div>
              {{/each}}
            </div>
          </article>
          <article class="relis-card">
            <div class="relis-section-heading">
              <div><p class="relis-kicker">Maîtrises et tests</p><h2
                >Compétences</h2></div>
              <label class="relis-compact-field">DD<input
                  type="number"
                  min="0"
                  value="15"
                  data-test-difficulty
                /></label>
            </div>
            <div class="relis-list relis-list--skills">
              {{#each skills}}
                <div class="relis-row relis-row--skill">
                  <button
                    type="button"
                    class="relis-link"
                    data-action="roll-skill"
                    data-skill-key="{{key}}"
                    data-owner-control
                    title="Tester {{label}}"
                  ><i
                      class="fa-solid fa-dice-d20"
                      aria-hidden="true"
                    ></i>{{label}}</button>
                  <span
                    class="relis-derived"
                    title="Total dérivé"
                  >{{total}}</span>
                  <select
                    data-document-field="system.skills.{{key}}.rank"
                    aria-label="Rang de {{label}}"
                  >{{selectOptions
                      masteryRanks
                      selected=rank
                      valueAttr="key"
                      labelAttr="label"
                    }}</select>
                </div>
              {{/each}}
            </div>
          </article>
        </div>
      </section>

      <section
        class="relis-tab-panel"
        id="relis-panel-progression"
        role="tabpanel"
        aria-labelledby="relis-tab-progression"
        data-tab-panel="progression"
        hidden
      >
        <div class="relis-content-grid">
          <article class="relis-card">
            <p class="relis-kicker">État actuel</p><h2>Progression</h2>
            <div class="relis-grid relis-grid--form">
              <label>Niveau<input
                  type="number"
                  min="1"
                  max="30"
                  value="{{system.level}}"
                  data-value-type="number"
                  data-document-field="system.level"
                /></label>
              <label>Étoiles mythiques<input
                  type="number"
                  min="0"
                  value="{{progression.mythicStars}}"
                  data-value-type="number"
                  data-document-field="system.progression.mythicStars"
                /></label>
            </div>
            <div class="relis-fact-list">
              <div><span>Choix en attente</span><strong
                >{{progression.pendingChoices.length}}</strong></div>
              <div><span>Gains automatiques</span><strong
                >{{progression.automaticGrants.length}}</strong></div>
              <div><span>Entrées d’historique</span><strong
                >{{progression.historyRefs.length}}</strong></div>
            </div>
          </article>
          <article class="relis-card">
            <p class="relis-kicker">Choix et historique</p><h2>Étapes de
              progression</h2>
            <div class="relis-empty-state"><i
                class="fa-solid fa-route"
                aria-hidden="true"
              ></i><p>L’historique, les gains automatiques et les choix différés
                seront manipulés par les assistants de 10-D4. Le présent panneau
                projette déjà leurs collections sans inventer d’XP.</p></div>
          </article>
        </div>
      </section>

      <section
        class="relis-tab-panel"
        id="relis-panel-capabilities"
        role="tabpanel"
        aria-labelledby="relis-tab-capabilities"
        data-tab-panel="capabilities"
        hidden
      >
        <div class="relis-section-heading">
          <div><p class="relis-kicker">Réserves et moyens</p><h2>Capacités &
              Énergies</h2></div>
          <button type="button" data-action="create-demo" data-owner-control><i
              class="fa-solid fa-flask"
              aria-hidden="true"
            ></i>Préparer la démonstration 10-C</button>
        </div>
        {{#if hasDemoEnergy}}
          <p class="relis-demo-notice">
            <i class="fa-solid fa-flask" aria-hidden="true"></i>
            Les CE affichées ici servent uniquement à la démonstration technique
            10-C. Elles ne constituent pas une ressource personnelle canonique.
          </p>
        {{/if}}
        {{#if energyPools.length}}
          <div class="relis-energy-grid">
            {{#each energyPools}}
              <article class="relis-energy-card {{cardClass}}">
                <strong>{{label}}</strong>
                <label>Actuel<input
                    type="number"
                    min="0"
                    max="{{maximum}}"
                    value="{{current}}"
                    data-value-type="number"
                    data-energy-index="{{index}}"
                    data-owner-control
                  /></label>
                <span>Maximum <b>{{maximum}}</b></span><span>Réservé
                  <b>{{reserved}}</b></span><span>Dette <b>{{debt}}</b></span>
              </article>
            {{/each}}
          </div>
        {{else}}
          <div class="relis-empty-state"><i
              class="fa-solid fa-battery-empty"
              aria-hidden="true"
            ></i><p>Aucune réserve. La démonstration ajoute 3 CE pour la
              recette.</p></div>
        {{/if}}
      </section>
      <section
        class="relis-tab-panel"
        id="relis-panel-health"
        role="tabpanel"
        aria-labelledby="relis-tab-health"
        data-tab-panel="health"
        hidden
      >
        <div class="relis-content-grid">
          <article class="relis-card">
            <p class="relis-kicker">État biologique</p><h2>Santé</h2>
            <div class="relis-grid relis-grid--form">
              <label>PV actuels<input
                  type="number"
                  min="0"
                  max="{{system.health.hitPoints.maximum}}"
                  value="{{system.health.hitPoints.current}}"
                  data-value-type="number"
                  data-document-field="system.health.hitPoints.current"
                /></label>
              <label>PV maximum<input
                  type="number"
                  min="1"
                  value="{{system.health.hitPoints.maximum}}"
                  data-value-type="number"
                  data-document-field="system.health.hitPoints.maximum"
                /></label>
              <label>Stress actuel<input
                  type="number"
                  min="0"
                  max="{{stress.max}}"
                  value="{{stress.value}}"
                  data-value-type="number"
                  data-document-field="system.health.stress.current"
                /></label>
              <label>Stress maximum<input
                  type="number"
                  value="{{stress.max}}"
                  disabled
                /></label>
              <label>Fatigue<input
                  type="number"
                  min="0"
                  max="5"
                  value="{{system.health.fatigue}}"
                  data-value-type="number"
                  data-document-field="system.health.fatigue"
                /></label>
              <label>Agonie<input
                  type="number"
                  min="0"
                  value="{{system.health.agony}}"
                  data-value-type="number"
                  data-document-field="system.health.agony"
                /></label>
              <label>Surmenage<input
                  type="number"
                  min="0"
                  value="{{system.health.overexertion}}"
                  data-value-type="number"
                  data-document-field="system.health.overexertion"
                /></label>
              <label>Contrecoup<input
                  type="number"
                  min="0"
                  value="{{system.health.backlash}}"
                  data-value-type="number"
                  data-document-field="system.health.backlash"
                /></label>
              <label>Stabilité<select
                  data-document-field="system.health.stability"
                >{{selectOptions
                    stabilityOptions
                    selected=system.health.stability
                    valueAttr="key"
                    labelAttr="label"
                  }}</select></label>
            </div>
          </article>
          <article class="relis-card">
            <p class="relis-kicker">Suivi actif</p><h2>Effets</h2>
            {{#if effects.length}}
              <div class="relis-list">
                {{#each effects}}
                  <div
                    class="relis-row relis-row--effect"
                    title="{{description}}"
                  ><img class="relis-effect-icon" src="{{icon}}" alt="" /><span
                      class="relis-effect-name"
                    >{{name}}</span><span class="relis-badge">Intensité
                      {{intensity}}</span><span
                      class="relis-badge"
                    >{{duration}}</span></div>
                {{/each}}
              </div>
            {{else}}<p class="relis-muted">Aucun effet actif.</p>{{/if}}
          </article>
          <article class="relis-card">
            <p class="relis-kicker">Besoins applicables</p><h2>Survie</h2>
            {{#if needs.length}}
              <div class="relis-list">
                {{#each needs}}
                  <div class="relis-row relis-row--need">
                    <span>{{label}}</span><strong>{{current}}</strong>
                    <span class="relis-badge">{{state}}</span>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <div class="relis-empty-state relis-empty-state--small"><i
                  class="fa-solid fa-lungs"
                  aria-hidden="true"
                ></i><p>Aucun besoin corporel n’est encore rattaché. Une absence
                  n’est pas affichée comme un faux zéro.</p></div>
            {{/if}}
          </article>
          <article class="relis-card">
            <p class="relis-kicker">Accès préparés</p><h2>Soins & anatomie</h2>
            <div class="relis-empty-state relis-empty-state--small"><i
                class="fa-solid fa-kit-medical"
                aria-hidden="true"
              ></i><p>Les emplacements de soins rapides, localisations de
                Blessures et dossiers médico-biologiques sont réservés. Les
                Items arrivent en 10-E ; les règles de soins et de biométrie en
                10-F.</p></div>
          </article>
        </div>
      </section>

      <section
        class="relis-tab-panel"
        id="relis-panel-relations"
        role="tabpanel"
        aria-labelledby="relis-tab-relations"
        data-tab-panel="relations"
        hidden
      >
        <article class="relis-card">
          <p class="relis-kicker">Réseau personnel</p><h2>Relations & Journal</h2>
          {{#if hasReferences}}
            <div class="relis-reference-grid">
              {{#each referenceGroups}}
                <section><h3>{{label}}</h3>
                  {{#if entries.length}}
                    <div class="relis-list">
                      {{#each entries}}
                        <div class="relis-row"><span>{{label}}</span><span
                            class="relis-badge"
                          >{{state}}</span></div>
                      {{/each}}
                    </div>
                  {{else}}<p class="relis-muted">Aucune référence.</p>{{/if}}
                </section>
              {{/each}}
            </div>
          {{else}}
            <div class="relis-empty-state"><i
                class="fa-solid fa-address-book"
                aria-hidden="true"
              ></i><p>Aucune relation, organisation, compte ou page de journal
                n’est encore liée. Ces dossiers restent des Documents séparés et
                ne sont jamais recopiés dans la fiche.</p></div>
          {{/if}}
        </article>
      </section>
    {{else}}
      <section
        class="relis-tab-panel"
        id="relis-panel-summary"
        role="tabpanel"
        aria-labelledby="relis-tab-summary"
        data-tab-panel="summary"
      >
        <div class="relis-dashboard-grid">
          <article class="relis-card relis-card--wide">
            <p class="relis-kicker">PNJ sapient</p><h2>Synthèse</h2>
            <div class="relis-grid relis-grid--form">
              <label>Densité<select
                  data-document-field="system.detailLevel"
                >{{selectOptions
                    npcDetailOptions
                    selected=system.detailLevel
                    valueAttr="key"
                    labelAttr="label"
                  }}</select></label>
              <label>Niveau<input
                  type="number"
                  min="1"
                  max="30"
                  value="{{system.level}}"
                  data-value-type="number"
                  data-document-field="system.level"
                /></label>
              <label>Rôle<input
                  type="text"
                  value="{{system.role}}"
                  data-document-field="system.role"
                /></label>
              <label>Attitude visible<input
                  type="text"
                  value="{{system.attitudeVisible}}"
                  data-document-field="system.attitudeVisible"
                /></label>
            </div>
            <div class="relis-fact-list">
              <div><span>Intégrité</span><strong
                >{{system.health.hitPoints.current}}
                  /
                  {{system.health.hitPoints.maximum}}
                  PV</strong></div>
              <div><span>Corps actif</span><strong
                >{{activeBody.name}}</strong></div>
              <div><span>Effets actifs</span><strong
                >{{effectCount}}</strong></div>
            </div>
          </article>
          <article class="relis-card">
            <p class="relis-kicker">Compétences utiles</p><h2>Actions rapides</h2>
            {{#if featuredSkills.length}}
              <div class="relis-list relis-list--compact">
                {{#each featuredSkills}}
                  <button
                    type="button"
                    class="relis-quick-roll"
                    data-action="roll-skill"
                    data-skill-key="{{key}}"
                    data-owner-control
                  ><i class="fa-solid fa-dice-d20" aria-hidden="true"></i><span
                    >{{label}}</span><strong>{{total}}</strong></button>
                {{/each}}
              </div>
            {{else}}<p class="relis-muted">Aucune Compétence favorite ou
                maîtrisée.</p>{{/if}}
          </article>
        </div>
      </section>
      <section
        class="relis-tab-panel"
        id="relis-panel-identity"
        role="tabpanel"
        aria-labelledby="relis-tab-identity"
        data-tab-panel="identity"
        hidden
      >
        <div class="relis-content-grid">
          <article class="relis-card"><p class="relis-kicker">Projection
              autorisée</p><h2>Identité</h2>
            <div class="relis-grid relis-grid--form">
              <label>Nom principal<input
                  type="text"
                  value="{{system.identity.primaryName}}"
                  data-document-field="system.identity.primaryName"
                /></label>
              <label>Nom affiché<input
                  type="text"
                  value="{{system.identity.publicName}}"
                  data-document-field="system.identity.publicName"
                /></label>
              <label>Pronoms<input
                  type="text"
                  value="{{system.identity.pronouns}}"
                  data-document-field="system.identity.pronouns"
                /></label>
              <label>Indicatif<input
                  type="text"
                  value="{{system.identity.callsign}}"
                  data-document-field="system.identity.callsign"
                /></label>
            </div>
          </article>
          <article class="relis-card"><p class="relis-kicker">Description
              visible</p><h2>Apparence</h2>
            <div class="relis-grid relis-grid--form">
              <label>Corpulence<input
                  type="text"
                  value="{{system.identity.appearance.build}}"
                  data-document-field="system.identity.appearance.build"
                /></label>
              <label>Voix<input
                  type="text"
                  value="{{system.identity.appearance.voice}}"
                  data-document-field="system.identity.appearance.voice"
                /></label>
              <label>Yeux ou capteurs<input
                  type="text"
                  value="{{system.identity.appearance.eyes}}"
                  data-document-field="system.identity.appearance.eyes"
                /></label>
              <label>Signes distinctifs<input
                  type="text"
                  value="{{system.identity.appearance.distinctiveMarks}}"
                  data-document-field="system.identity.appearance.distinctiveMarks"
                /></label>
            </div>
          </article>
          <p class="relis-scope-note relis-card relis-card--wide">Une couverture
            publique ne doit contenir aucune identité réelle, intention secrète
            ou note MJ. Ces vérités demeurent dans des Documents séparés.</p>
        </div>
      </section>
      <section
        class="relis-tab-panel"
        id="relis-panel-mechanics"
        role="tabpanel"
        aria-labelledby="relis-tab-mechanics"
        data-tab-panel="mechanics"
        hidden
      >
        <div class="relis-columns">
          <article class="relis-card"><p class="relis-kicker">Valeurs
              fondamentales</p><h2>Attributs</h2>
            <div class="relis-list">
              {{#each attributes}}
                <div class="relis-row relis-row--attribute">
                  <span>{{label}}</span><span
                    class="relis-derived"
                  >{{effective}}</span>
                  <input
                    type="number"
                    min="-5"
                    max="8"
                    value="{{base}}"
                    data-value-type="number"
                    data-document-field="system.attributes.{{key}}.base"
                  />
                  <label class="relis-partial">+<input
                      type="checkbox"
                      {{checked partial}}
                      data-document-field="system.attributes.{{key}}.partial"
                    /></label>
                </div>
              {{/each}}
            </div>
          </article>
          <article class="relis-card"><div class="relis-section-heading">
              <div><p class="relis-kicker">Même moteur que les PJ</p><h2
                >Compétences</h2></div>
              <label class="relis-compact-field">DD<input
                  type="number"
                  min="0"
                  value="15"
                  data-test-difficulty
                /></label>
            </div>
            {{#if skills.length}}
              <div class="relis-list relis-list--skills">
                {{#each skills}}
                  <div class="relis-row relis-row--skill">
                    <button
                      type="button"
                      class="relis-link"
                      data-action="roll-skill"
                      data-skill-key="{{key}}"
                      data-owner-control
                    ><i class="fa-solid fa-dice-d20" aria-hidden="true"></i>
                      {{label}}</button>
                    <span class="relis-derived">{{total}}</span>
                    <select
                      data-document-field="system.skills.{{key}}.rank"
                    >{{selectOptions
                        masteryRanks
                        selected=rank
                        valueAttr="key"
                        labelAttr="label"
                      }}</select>
                  </div>
                {{/each}}
              </div>
            {{else}}<div class="relis-empty-state relis-empty-state--small"><p
                >Cette densité replie les Compétences non maîtrisées. Passez en
                  vue complète pour inspecter les vingt-cinq.</p></div>{{/if}}
          </article>
        </div>
      </section>

      <section
        class="relis-tab-panel"
        id="relis-panel-health"
        role="tabpanel"
        aria-labelledby="relis-tab-health"
        data-tab-panel="health"
        hidden
      >
        <div class="relis-content-grid">
          <article class="relis-card"><p class="relis-kicker">État</p><h2
            >Santé</h2><div class="relis-grid relis-grid--form">
              <label>PV actuels<input
                  type="number"
                  min="0"
                  max="{{system.health.hitPoints.maximum}}"
                  value="{{system.health.hitPoints.current}}"
                  data-value-type="number"
                  data-document-field="system.health.hitPoints.current"
                /></label>
              <label>PV maximum<input
                  type="number"
                  min="1"
                  value="{{system.health.hitPoints.maximum}}"
                  data-value-type="number"
                  data-document-field="system.health.hitPoints.maximum"
                /></label>
              <label>Stress<input
                  type="number"
                  min="0"
                  max="{{stress.max}}"
                  value="{{stress.value}}"
                  data-value-type="number"
                  data-document-field="system.health.stress.current"
                /></label>
              <label>Fatigue<input
                  type="number"
                  min="0"
                  max="5"
                  value="{{system.health.fatigue}}"
                  data-value-type="number"
                  data-document-field="system.health.fatigue"
                /></label>
            </div></article>
          <article class="relis-card"><p class="relis-kicker">Suivi actif</p><h2
            >Effets</h2>
            {{#if effects.length}}<div class="relis-list">{{#each effects}}
                  <div class="relis-row relis-row--effect"><img
                      class="relis-effect-icon"
                      src="{{icon}}"
                      alt=""
                    /><span class="relis-effect-name">{{name}}</span><span
                      class="relis-badge"
                    >{{duration}}</span></div>{{/each}}</div>
            {{else}}<p class="relis-muted">Aucun effet actif.</p>{{/if}}
          </article>
        </div>
      </section>
      <section
        class="relis-tab-panel"
        id="relis-panel-relations"
        role="tabpanel"
        aria-labelledby="relis-tab-relations"
        data-tab-panel="relations"
        hidden
      >
        <div class="relis-content-grid">
          <article class="relis-card"><p class="relis-kicker">Aide au MJ</p><h2
            >Comportement</h2><div class="relis-grid relis-grid--form">
              <label>Seuil de repli<input
                  type="number"
                  min="0"
                  value="{{system.behavior.retreatThreshold}}"
                  data-value-type="number"
                  data-document-field="system.behavior.retreatThreshold"
                /></label>
              <label>Reddition<input
                  type="text"
                  value="{{system.behavior.surrender}}"
                  data-document-field="system.behavior.surrender"
                /></label>
            </div><p class="relis-scope-note">Ces données aident le MJ ; elles
              ne jouent jamais le PNJ à sa place.</p></article>
          <article class="relis-card"><p class="relis-kicker">Documents liés</p><h2
            >Relations</h2>
            {{#if hasReferences}}<div class="relis-fact-list">{{#each
                  referenceGroups
                }}<div><span>{{label}}</span><strong
                    >{{entries.length}}</strong></div>{{/each}}</div>
            {{else}}<div class="relis-empty-state relis-empty-state--small"><p
                >Aucune référence autorisée. Les intentions et notes secrètes ne
                  sont pas stockées ici.</p></div>{{/if}}
          </article>
        </div>
      </section>
    {{/if}}
    {{! Shared physical inventory: character/inventory and npc/capabilities. }}
    {{#if isPerson}}
      <section
        class="relis-tab-panel"
        id="relis-panel-{{inventoryTab}}"
        role="tabpanel"
        aria-labelledby="relis-tab-{{inventoryTab}}"
        data-tab-panel="{{inventoryTab}}"
        data-inventory-view
        hidden
      >
        <section class="relis-carrying" aria-label="Charge du corps actif">
          <div class="relis-carrying-heading"><div><p
                class="relis-kicker"
              >Charge portée · {{activeBody.name}}</p><strong>{{carrying.mass}}
                kg</strong></div><span
              class="relis-state-chip"
            >{{carrying.status}}</span></div>
          {{#if carrying.defined}}
            <div
              class="relis-carrying-meter"
              role="meter"
              aria-label="Charge portée"
              aria-valuemin="0"
              aria-valuemax="{{carrying.overloaded}}"
              aria-valuenow="{{carrying.meterValue}}"
              aria-valuetext="{{carrying.mass}} kg — {{carrying.status}}"
            >
              <span
                class="relis-carrying-fill"
                style="width: {{carrying.percent}}%"
              ></span>
              <span
                class="relis-carrying-marker"
                style="left: {{carrying.marker}}%"
              ></span>
            </div>
            <div class="relis-carrying-thresholds"><span>Chargé ≥
                {{carrying.loaded}}
                kg</span><span>Surchargé ≥
                {{carrying.overloaded}}
                kg</span></div>
          {{else}}<p class="relis-muted">Les seuils du corps actif ne sont pas
              renseignés.</p>{{/if}}
          {{#if carrying.missing}}<p
              class="relis-inventory-warning"
            >{{carrying.missing}}
              masse(s) à renseigner ou localisation(s) à corriger : le total
              connu est incomplet.</p>{{/if}}
          {{#if canConfigureBody}}<button
              type="button"
              data-equipment-command="body"
              data-owner-control
            >Configurer le portage et les mains</button>{{/if}}
          <details class="relis-inventory-details"><summary>Détails de charge</summary><p
            >Les objets au sol et ceux des autres corps sont exclus. Les
              conteneurs et leur contenu sont comptés une seule fois.</p><p
            >Source des seuils : {{activeBody.carrying.source}}</p><p>Inventaire
              complet :
              {{inventoryTotals.itemCount}}
              lignes ·
              {{inventoryTotals.mass}}. Les volumes et capacités restent
              consultables sur les objets et conteneurs.</p></details>
        </section>
        <section
          class="relis-equipment-overview"
          aria-label="Équipement du corps actif"
        >
          {{#each equipmentOverview.entries}}<details
              class="relis-equipment-counter {{warningClass}}"
            >
              <summary>{{label}} <b>{{count}} / {{capacity}}</b></summary>
              {{#each items}}<button
                  type="button"
                  class="relis-link"
                  data-action="open-item"
                  data-item-id="{{id}}"
                >{{name}}</button>{{else}}<p>Aucun objet.</p>{{/each}}
            </details>{{/each}}
          {{#if equipmentOverview.uncounted}}<details
              class="relis-equipment-counter"
            ><summary>Vêtements et objets sans quota</summary>{{#each
                equipmentOverview.uncounted
              }}<button
                  type="button"
                  class="relis-link"
                  data-action="open-item"
                  data-item-id="{{id}}"
                >{{name}}</button>{{/each}}</details>{{/if}}
        </section>
        {{#if equipmentRecovery}}<aside class="relis-inventory-diagnostics"><p
            >Une opération matérielle ou d’équipement a été interrompue.
              Restaurer sa sauvegarde avant de poursuivre.</p>{{#if
              canConfigureBody
            }}<button
                type="button"
                data-equipment-command="recover"
                data-owner-control
              >Restaurer l’équipement précédent</button>{{/if}}</aside>{{/if}}
        <section class="relis-finance-band" aria-label="Argent du personnage">
          <div><p class="relis-kicker">Moyens financiers</p><h2>Liquide porté</h2></div>
          <div class="relis-finance-values">
            {{#each physicalCash}}<span><b>{{amountLabel}}</b>
                {{label}}</span>{{else}}<span>Aucun Item de monnaie physique
                configuré.</span>{{/each}}
          </div>
          <div class="relis-finance-bank"><span>Argent en banque</span><b>Non
              raccordé</b><small>Datapad 10-G7 · comptes et opérations 10-J1</small></div>
        </section>

        {{#if hasInventoryDiagnostics}}
          <aside
            class="relis-inventory-diagnostics"
            aria-label="Diagnostics d’inventaire"
          >
            {{#each inventoryDiagnostics}}
              <p class="relis-item-diagnostic relis-item-diagnostic--{{level}}">
                <i
                  class="fa-solid fa-triangle-exclamation"
                  aria-hidden="true"
                ></i>
                {{message}}
              </p>
            {{/each}}
          </aside>
        {{/if}}

        <div class="relis-section-heading relis-inventory-heading">
          <div>
            <p class="relis-kicker">Items frères, emplacement unique</p>
            <h2>Inventaire physique</h2>
          </div>
          {{#if editable}}
            <button
              type="button"
              data-action="create-inventory-item"
              data-owner-control
            ><i class="fa-solid fa-plus" aria-hidden="true"></i>
              Nouvel objet</button>
          {{/if}}
        </div>

        <div class="relis-inventory-toolbar">
          <label>Rechercher par nom
            <input
              type="search"
              data-inventory-search
              placeholder="Nom d’un objet…"
            /></label>
          <button type="button" data-inventory-clear>Effacer</button>
          <label><input type="checkbox" data-inventory-empty />
            Catégories vides</label>
        </div>
        <p data-inventory-result role="status" aria-live="polite"></p>

        <div class="relis-inventory-tree" aria-label="Inventaire et conteneurs">
          {{#each inventoryGroups}}
            <section
              class="relis-inventory-category"
              data-inventory-category="{{id}}"
            >
              <h3><button
                  type="button"
                  data-inventory-fold="category:{{id}}"
                  aria-expanded="true"
                ><span class="relis-fold-chevron" aria-hidden="true">▾</span>
                  {{label}}
                  <small>{{inventoryRows.length}}
                    ligne(s)</small></button></h3>
              <div data-category-content>
                {{#each inventoryRows}}
                  <article
                    class="{{rowClasses}}"
                    data-inventory-row
                    data-item-id="{{id}}"
                    data-item-name="{{name}}"
                    data-ancestors="{{ancestors}}"
                    style="--relis-inventory-depth: {{indent}}px"
                  >
                    <div class="relis-inventory-main">
                      <img src="{{img}}" alt="" />
                      <div class="relis-inventory-identity">
                        <button
                          type="button"
                          class="relis-link"
                          data-action="open-item"
                          data-item-id="{{id}}"
                        >{{name}}</button>
                        {{#if classificationLabel}}<small
                          >{{classificationLabel}}</small>{{/if}}
                        {{#if @root.editable}}<details
                            class="relis-equipment-menu"
                            data-equipment-menu
                            data-owner-control
                          >
                            <summary
                              class="relis-equipment-state"
                              aria-label="Changer l’état de {{name}}"
                            ><i
                                class="fa-solid {{equipmentIcon}}"
                                aria-hidden="true"
                              ></i>
                              {{equipmentLabel}}</summary>
                            <div class="relis-equipment-options">
                              {{#each equipmentActions}}<button
                                  type="button"
                                  data-equipment-command="state"
                                  data-item-id="{{itemId}}"
                                  data-equipment-state="{{state}}"
                                  aria-disabled="{{unavailable}}"
                                >
                                  <i
                                    class="fa-solid {{icon}}"
                                    aria-hidden="true"
                                  ></i><span>{{label}}{{#if current}}
                                      · actuel{{/if}}{{#if reason}}<small
                                      >{{reason}}</small>{{/if}}</span>
                                </button>{{/each}}
                              <small>Choisir confirme le temps et l’aide requis
                                par la source :
                                {{equipmentDuration}}. Aucun débit automatique
                                d’Actions. Déplacer choisit le conteneur.</small>
                            </div>
                          </details>{{else}}<span class="relis-state-chip"><i
                              class="fa-solid {{equipmentIcon}}"
                              aria-hidden="true"
                            ></i>
                            {{equipmentLabel}}</span>{{/if}}
                        {{#if equipmentBody}}<small>Corps :
                            {{equipmentBody}}</small>{{/if}}
                        <small>Emplacements : {{equipmentSlots}}</small>
                        {{#if technicalCapacity}}<small>Modules :
                            {{technicalCapacity}}</small>{{/if}}
                        {{#if equipmentHost}}<small>Installé sur :
                            {{equipmentHost}}</small>{{/if}}
                        {{#if warning}}<span class="relis-inventory-warning">⚠
                            {{condition}}
                            ·
                            {{accessibility}}
                            · usure
                            {{wear}}</span>{{/if}}
                        {{#if lot}}<small>Lot : {{lot}}</small>{{/if}}
                        {{#each materialStatus}}<small
                            class="relis-material-status"
                          >{{this}}</small>{{/each}}
                        {{#if path}}<small>{{path}}</small>{{/if}}
                      </div>
                      <div class="relis-inventory-quantity">
                        <b>{{quantity}}</b><span>{{quantityUnit}}</span>
                      </div>
                      <div class="relis-inventory-location">
                        <span>Emplacement</span><b>{{location}}</b>
                      </div>
                      <div class="relis-inventory-load">
                        <span>Masse propre</span><b>{{ownMass}}</b>
                        {{#if isContainer}}<small>Avec contenu :
                            {{subtreeMass}}</small>{{/if}}
                      </div>
                    </div>

                    {{#if loadedContentLines}}<div
                        class="relis-loaded-inline"
                        aria-label="Munitions chargées"
                      >{{#each loadedContentLines}}<span><i
                              class="fa-solid fa-circle-dot"
                              aria-hidden="true"
                            ></i>
                            {{this}}</span>{{/each}}</div>{{/if}}

                    {{#if childCount}}<button
                        type="button"
                        class="relis-container-toggle"
                        data-inventory-fold="item:{{id}}"
                        aria-expanded="true"
                      ><span
                          class="relis-fold-chevron"
                          aria-hidden="true"
                        >▾</span>
                        Éléments liés à
                        {{name}}
                        ·
                        {{childCount}}
                        ligne(s)</button>{{/if}}
                    <details class="relis-inventory-details">
                      <summary>Détails de l’objet</summary>
                      <div class="relis-inventory-detail-grid">
                        <span>Type <b>{{typeLabel}}</b></span>
                        <span>État <b>{{condition}}</b></span>
                        <span>Accessibilité <b>{{accessibility}}</b></span>
                        <span>Usure <b>{{wear}}</b></span>
                        <span>Provenance <b>{{provenanceSource}}</b></span>
                        <span>Masse unitaire <b>{{massEach}}</b></span>
                        <span>Volume unitaire <b>{{volumeEach}}</b></span>
                        <span>Encombrement unitaire <b>{{bulkEach}}</b></span>
                        <span>Installation requise
                          <b>{{technicalNeeds}}</b></span>
                        <span>Temps / aide <b>{{equipmentTime}}</b></span>
                        {{#if @root.editable}}<button
                            type="button"
                            data-action="open-item"
                            data-item-id="{{id}}"
                            data-owner-control
                          >Modifier les propriétés dans la fiche</button>{{/if}}
                      </div>
                    </details>
                    {{#if hasModulePorts}}
                      <details class="relis-material-ports">
                        <summary>Ports de modules</summary>
                        <div class="relis-material-port-list">
                          {{#each modulePorts}}<div class="relis-material-port">
                              <span><b>{{label}}</b>
                                ·
                                {{used}}
                                /
                                {{capacity}}
                                occupé(s) ·
                                {{free}}
                                libre(s){{#if installedNames}}<small
                                  >{{installedNames}}</small>{{/if}}</span>
                              {{#if @root.editable}}<button
                                  type="button"
                                  data-material-command="port"
                                  data-item-id="{{hostId}}"
                                  data-slot-key="{{key}}"
                                  data-owner-control
                                >Gérer</button>{{/if}}
                            </div>{{/each}}
                        </div>
                      </details>
                    {{/if}}
                    {{#if isContainer}}
                      <details class="relis-container-capacity">
                        <summary>{{childCount}}
                          ligne(s) directe(s) · capacités</summary>
                        <div>
                          <span>Masse <b>{{capacityMass}}</b></span>
                          <span>Volume <b>{{capacityVolume}}</b></span>
                          <span>Encombrement <b>{{capacityBulk}}</b></span>
                          <span>Unités <b>{{capacityUnits}}</b></span>
                        </div>
                      </details>
                    {{/if}}

                    <div
                      class="relis-inventory-actions"
                      aria-label="Opérations sur {{name}}"
                    >
                      {{#if pending}}
                        <span
                          class="relis-state-chip relis-state-chip--warning"
                        >Transfert en récupération</span>
                      {{else}}
                        {{#if quarantined}}
                          <span
                            class="relis-state-chip relis-state-chip--danger"
                          >Transfert en quarantaine</span>
                        {{else}}
                          {{#if @root.editable}}
                            {{#if canLoadAmmunition}}<button
                                type="button"
                                data-material-command="load"
                                data-item-id="{{id}}"
                                data-owner-control
                                title="Charger des munitions compatibles"
                              ><i
                                  class="fa-solid fa-rotate"
                                  aria-hidden="true"
                                ></i>
                                Charger</button>{{/if}}
                            {{#if canUnloadAmmunition}}<button
                                type="button"
                                data-material-command="unload"
                                data-item-id="{{id}}"
                                data-owner-control
                                title="Décharger vers l’inventaire"
                              ><i
                                  class="fa-solid fa-eject"
                                  aria-hidden="true"
                                ></i>
                                Décharger</button>{{/if}}
                            {{#if canReceiveEnergy}}<button
                                type="button"
                                data-material-command="energy"
                                data-item-id="{{id}}"
                                data-owner-control
                                title="Transférer des CE depuis une source compatible"
                              ><i
                                  class="fa-solid fa-battery-half"
                                  aria-hidden="true"
                                ></i>
                                Recharger</button>{{/if}}
                            {{#if canConsume}}<button
                                type="button"
                                data-material-command="consume"
                                data-item-id="{{id}}"
                                data-owner-control
                                title="Dépenser une charge ou une unité"
                              ><i
                                  class="fa-solid fa-capsules"
                                  aria-hidden="true"
                                ></i>
                                Employer</button>{{/if}}
                            {{#if canSplit}}<button
                                type="button"
                                data-action="split-inventory-stack"
                                data-item-id="{{id}}"
                                data-owner-control
                                title="Scinder cette pile"
                              ><i
                                  class="fa-solid fa-scissors"
                                  aria-hidden="true"
                                ></i>
                                Scinder</button>{{/if}}
                            {{#if canMerge}}<button
                                type="button"
                                data-action="merge-inventory-stack"
                                data-item-id="{{id}}"
                                data-owner-control
                                title="Fusionner une pile strictement compatible"
                              ><i
                                  class="fa-solid fa-object-group"
                                  aria-hidden="true"
                                ></i>
                                Fusionner</button>{{/if}}
                            {{#if canMove}}<button
                                type="button"
                                data-action="move-inventory-item"
                                data-item-id="{{id}}"
                                data-owner-control
                                title="Déplacer dans ou hors d’un conteneur"
                              ><i
                                  class="fa-solid fa-box-open"
                                  aria-hidden="true"
                                ></i>
                                Déplacer</button>{{/if}}
                            {{#if canTransfer}}<button
                                type="button"
                                data-action="transfer-inventory-item"
                                data-item-id="{{id}}"
                                data-owner-control
                                title="Transférer vers un autre Actor"
                              ><i
                                  class="fa-solid fa-arrow-right-arrow-left"
                                  aria-hidden="true"
                                ></i>
                                Transférer</button>{{/if}}
                          {{/if}}
                        {{/if}}
                      {{/if}}
                    </div>
                  </article>
                {{/each}}
              </div>
            </section>
          {{/each}}
        </div>
        {{#unless hasInventory}}
          <div class="relis-empty-state"><i
              class="fa-solid fa-box-open"
              aria-hidden="true"
            ></i><p>Aucun objet physique. Créez-en un ici ou déposez une source
              Item sur l’Actor.</p></div>
        {{/unless}}

        <div class="relis-content-grid relis-inventory-secondary">
          <article class="relis-card">
            <p class="relis-kicker">Actions et capacités liées</p><h2>Items non
              physiques</h2>
            {{#if relatedItems.length}}
              <div class="relis-list">
                {{#each relatedItems}}
                  <div class="relis-row relis-row--item">
                    <button
                      type="button"
                      class="relis-link"
                      data-action="open-item"
                      data-item-id="{{id}}"
                    >{{name}}</button>
                    <span class="relis-badge">{{typeLabel}}</span>
                    {{#if @root.editable}}{{#if canRoll}}<button
                          type="button"
                          data-action="roll-action"
                          data-item-id="{{id}}"
                          data-owner-control
                        ><i
                            class="fa-solid fa-dice-d20"
                            aria-hidden="true"
                          ></i>Lancer</button>{{/if}}{{/if}}
                  </div>
                {{/each}}
              </div>
            {{else}}<p class="relis-muted">Aucun Item non physique embarqué.</p>{{/if}}
          </article>
          <article class="relis-card">
            <p class="relis-kicker">Équipement mémorisé</p><h2>Garde-Robe</h2>
            <h3>Ensembles d’équipement</h3>
            <p>Références vers vos objets réels, avec aperçu avant application.
              Les Présentations et images de Garde-Robe seront raccordées en
              10-D5.</p>
            {{#if editable}}<button
                type="button"
                data-equipment-command="save"
                data-owner-control
              >Mémoriser l’équipement actuel</button>{{/if}}
            {{#each equipmentOutfits}}<div class="relis-row"><strong
                >{{name}}</strong><span>{{equipmentEntries.length}}
                  référence(s)</span>{{#if @root.editable}}<button
                    type="button"
                    data-equipment-command="apply"
                    data-outfit-id="{{id}}"
                    data-owner-control
                  >Voir l’aperçu</button>{{/if}}</div>{{else}}<p
                class="relis-muted"
              >Aucun ensemble mémorisé.</p>{{/each}}
          </article>
        </div>
      </section>
    {{/if}}
  </main>

  <footer class="relis-sheet-footer">10-E3-P validé · 10-E4-P en recette ·
    paquet
    {{packageVersion}}</footer>
</section>