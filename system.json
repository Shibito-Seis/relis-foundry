        },
        {
          "name": "Actions et pouvoirs",
          "sorting": "m",
          "packs": [
            "progression-actions",
            "progression-powers-mana",
            "progression-powers-prana",
            "progression-powers-flux"
          ]
        }
      ]
    },
    {
      "name": "RE:LIS — Matériel personnel",
      "sorting": "m",
      "folders": [
        {
          "name": "Combat et protection",
          "sorting": "m",
          "packs": ["material-weapons", "material-armor", "material-ammunition"]
        },
        {
          "name": "Équipement",
          "sorting": "m",
          "packs": ["material-equipment", "material-consumables"]
        },
        {
          "name": "Logistique",
          "sorting": "m",
          "packs": ["material-resources", "material-containers"]
        }
      ]
    }
  ],
