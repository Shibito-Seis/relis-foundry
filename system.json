  "packFolders": [
    {
      "name": "RE:LIS — Création de personnage",
      "sorting": "m",
      "packs": [
        "creation-ancestries",
        "creation-profiles",
        "creation-origins",
        "creation-advantages",
        "creation-drawbacks",
        "creation-posts"
      ]
    },
    {
      "name": "RE:LIS — Progression personnelle",
      "sorting": "m",
      "folders": [
        {
          "name": "Voies et spécialisations",
          "sorting": "m",
          "packs": ["progression-paths", "progression-specializations"]
        },
        {
          "name": "Talents",
