{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Shibito-Seis/relis-foundry/content/schemas/personal-manifest.schema.json",
  "title": "Manifeste de contenu personnel RE:LIS",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "system",
    "contentVersion",
    "strictReferences",
    "packs"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "relis.personal-content" },
    "formatVersion": { "const": 1 },
    "system": { "const": "relis" },
    "contentVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "strictReferences": { "type": "boolean" },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "label",
          "documentType",
          "source",
          "itemTypes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "documentType": { "const": "Item" },
          "source": { "type": "string", "minLength": 1 },
          "itemTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
